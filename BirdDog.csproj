<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BirdDog</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      NOTE (mristin):
      We keep the GC from blocking the render loop for long; the camera frames
      are large objects.
    -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests live in their own project and must not end up in the game. -->
    <Compile Remove="tests/**" />
    <Compile Remove="venv/**" />
    <Compile Remove=".cache/**" />
  </ItemGroup>
  <ItemGroup>
    <!--
      NOTE (mristin):
      We stay with ONNX Runtime 1.19, the last version whose libraries for
      macOS run on macOS 11 (from 1.20 on, they need macOS 13.3, and from 1.24
      on, there is none for the Intel Macs); keep the tests at the same version.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
  </ItemGroup>
</Project>
