[gd_resource type="Resource" script_class="Mission" format=3]

[ext_resource type="Script" path="res://scenes/missions/data/mission.gd" id="1_ext"]
[ext_resource type="Resource" path="res://data/world/ports/pula.tres" id="2_ext"]
[ext_resource type="Resource" path="res://data/world/seas/bura_kvarner.tres" id="3_ext"]
[ext_resource type="Resource" path="res://data/world/people/baba_stana.tres" id="4_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/briefing_step.gd" id="5_ext"]
[ext_resource type="Resource" path="res://data/world/items/salt.tres" id="6_ext"]
[ext_resource type="Resource" path="res://data/world/ports/ston.tres" id="7_ext"]
[ext_resource type="Resource" path="res://data/world/people/salter_ston.tres" id="8_ext"]
[ext_resource type="Script" path="res://scenes/missions/data/item_source.gd" id="9_ext"]
[ext_resource type="Resource" path="res://data/world/ports/pag.tres" id="10_ext"]
[ext_resource type="Resource" path="res://data/world/people/salter_pag.tres" id="11_ext"]
[ext_resource type="Resource" path="res://data/world/ports/trieste.tres" id="12_ext"]
[ext_resource type="Resource" path="res://data/world/people/salter_trieste.tres" id="13_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/collect_step.gd" id="14_ext"]
[ext_resource type="Resource" path="res://data/world/ports/grebastica.tres" id="15_ext"]
[ext_resource type="Resource" path="res://data/world/people/anica.tres" id="16_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/deliver_step.gd" id="17_ext"]
[ext_resource type="Resource" path="res://data/world/ports/senj.tres" id="18_ext"]
[ext_resource type="Resource" path="res://data/world/people/juraj.tres" id="19_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/celebration_step.gd" id="20_ext"]
[ext_resource type="Texture2D" path="res://assets/period/ports/senj.jpg" id="21_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/mission_step.gd" id="22_ext"]

[sub_resource type="Resource" id="briefing"]
script = ExtResource("5_ext")
id = "briefing"
speaker = ExtResource("4_ext")
lines = Array[String](["Captain, winter is coming, and the Aga hoards all the salt.", "Without salt, the villages can not keep their fish and their meat.", "Fetch two loads of salt: Ragusa sells it in Ston, Venice in Pag, the Habsburgs in Trieste."])

[sub_resource type="Resource" id="collect_source_1"]
script = ExtResource("9_ext")
item = ExtResource("6_ext")
port = ExtResource("7_ext")
person = ExtResource("8_ext")
lines = Array[String](["Salt from the pans of Ragusa, at a fair price!", "Our walls are the longest in the land, to keep the salt safe."])

[sub_resource type="Resource" id="collect_source_2"]
script = ExtResource("9_ext")
item = ExtResource("6_ext")
port = ExtResource("10_ext")
person = ExtResource("11_ext")
lines = Array[String](["The salt of Pag belongs to Venice, captain.", "But for the villages, I will sell you a load."])

[sub_resource type="Resource" id="collect_source_3"]
script = ExtResource("9_ext")
item = ExtResource("6_ext")
port = ExtResource("12_ext")
person = ExtResource("13_ext")
lines = Array[String](["Ja, salt of the Habsburgs, white as snow!", "A long way north, but here it is."])

[sub_resource type="Resource" id="collect"]
script = ExtResource("14_ext")
id = "collect"
sources = Array[ExtResource("9_ext")]([SubResource("collect_source_1"), SubResource("collect_source_2"), SubResource("collect_source_3")])
needed = 2
objective = "Fetch {count} more {count|load|loads} of salt."

[sub_resource type="Resource" id="grebastica"]
script = ExtResource("17_ext")
id = "grebastica"
item = ExtResource("6_ext")
port = ExtResource("15_ext")
recipient = ExtResource("16_ext")
objective = "Bring a load of salt to {port}."
thanks = Array[String](["Salt! Now we can keep our fish for the winter.", "Thank you, captain!"])

[sub_resource type="Resource" id="senj"]
script = ExtResource("17_ext")
id = "senj"
item = ExtResource("6_ext")
port = ExtResource("18_ext")
recipient = ExtResource("19_ext")
objective = "Bring the other load to the villages behind {port}."
thanks = Array[String](["Welcome to Senj, captain! I am Juraj, a captain of the uskoks.", "The villages behind the mountains thank you for the salt.", "Listen: when the bura blows, stay close to the islands. From now on, my scouts watch the sea for you."])

[sub_resource type="Resource" id="celebration"]
script = ExtResource("20_ext")
id = "celebration"
speaker = ExtResource("19_ext")
lines = Array[String](["The bura blows, and the salt is safe in the villages!", "Tonight we dance in Senj, captain!"])

[resource]
script = ExtResource("1_ext")
id = "salt_for_the_winter"
number = 3
title = "Salt for the Winter"
summary = "The Aga hoards the salt. Fetch salt and bring it to the villages before winter."
start_port = ExtResource("2_ext")
clock_days = 13.0
provisions_days = 10.8
sea = ExtResource("3_ext")
steps = Array[ExtResource("22_ext")]([SubResource("briefing"), SubResource("collect"), SubResource("grebastica"), SubResource("senj"), SubResource("celebration")])
fun_fact = "The walls of Ston, more than five kilometres long, were built by Ragusa to protect its salt pans, which still give salt today."
victory_title = "Salt for everybody!"
victory_lines = Array[String](["The villages can keep their fish and their meat for the winter.", "The Aga's hoard is worth nothing now."])
reward = "Juraj, the uskok captain of Senj, now scouts the sea for you."
victory_picture = ExtResource("21_ext")
victory_person = ExtResource("19_ext")
