[ext_resource type="Script" path="res://scenes/missions/steps/deliver_step.gd" id="5_ext"]
[ext_resource type="Resource" path="res://data/world/items/ch3_new_cap.tres" id="6_ext"]
[ext_resource type="Resource" path="res://data/world/ports/venice.tres" id="7_ext"]
[ext_resource type="Resource" path="res://data/world/people/alvise.tres" id="8_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/hearing_step.gd" id="9_ext"]
