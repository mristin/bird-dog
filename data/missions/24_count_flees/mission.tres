[sub_resource type="Resource" id="briefing"]
script = ExtResource("26_ext")
id = "briefing"
speaker = ExtResource("2_ext")
lines = Array[String](["Captain, the Count has fled with his Golden Charter!", "Without the charter, the judges can not see his forgery.", "Chase him! A man so fine can not hide for long."])

[sub_resource type="Resource" id="trail"]
script = ExtResource("27_ext")
id = "trail"
ports = Array[ExtResource("11_ext")]([ExtResource("3_ext"), ExtResource("4_ext"), ExtResource("5_ext"), ExtResource("6_ext"), ExtResource("7_ext"), ExtResource("8_ext"), ExtResource("9_ext"), ExtResource("10_ext")])
length = 4
fixed_route = false
max_route_km = 600.0
max_difficulty = 3
clue_templates = Array[String](["He asked the way to {fact}.", "He sailed on toward {fact}.", "I heard him talk about {fact}."])
reveal = Array[ExtResource("16_ext")]([ExtResource("12_ext"), ExtResource("13_ext"), ExtResource("14_ext"), ExtResource("15_ext")])
hallmark_template = "The Count had {hallmark}."
question = "Have you seen Count Malvento?"
found_line = "He is here, hiding among the people of the harbour! But which one is he?"

[sub_resource type="Resource" id="lineup"]
script = ExtResource("28_ext")
id = "lineup"
target = ExtResource("17_ext")
decoys = Array[Resource]([ExtResource("18_ext"), ExtResource("19_ext"), ExtResource("20_ext")])
question = "Which one is the Count?"
wrong_line = "No, that is not the Count! Remember all four things you learned."
right_line = "\"Alright, alright! Here is the charter. It was such a beautiful charter...\""
gives = ExtResource("21_ext")

[sub_resource type="Resource" id="celebration"]
script = ExtResource("29_ext")
id = "celebration"
speaker = ExtResource("17_ext")
lines = Array[String](["\"Fine, I will come before the judges in Trani.\"", "With the Golden Charter, the crew holds everything the judges need."])

[resource]
script = ExtResource("1_ext")
id = "count_flees"
number = 24
chapter = 2
title = "The Count Flees"
summary = "The Count flees with his charter. Yellow gloves, a smell of violets, a wig too big, a ring with a false seal."
start_port = ExtResource("22_ext")
clock_days = 14.0
provisions_days = 10.8
sea = ExtResource("23_ext")
steps = Array[ExtResource("24_ext")]([SubResource("briefing"), SubResource("trail"), SubResource("lineup"), SubResource("celebration")])
fun_fact = "Around 1600, perfumed gloves were the height of fashion. Gloves were scented with violets, roses or amber, also to hide the smell of the leather."
victory_title = "The charter is yours!"
victory_lines = Array[String](["You chased the Count along the whole coast and found him.", "Now the crew holds the Golden Charter."])
victory_picture = ExtResource("25_ext")
victory_person = ExtResource("2_ext")
