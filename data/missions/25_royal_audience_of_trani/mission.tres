[sub_resource type="Resource" id="briefing"]
script = ExtResource("24_ext")
id = "briefing"
speaker = ExtResource("2_ext")
lines = Array[String](["Captain, the judges of the Royal Audience in Trani are ready.", "Bring them the proofs and the witnesses:", "Luka here in Bari, Michele in Manfredonia and Vito in Monopoli."])

[sub_resource type="Resource" id="witnesses_source_1"]
script = ExtResource("12_ext")
item = ExtResource("3_ext")
port = ExtResource("4_ext")
person = ExtResource("5_ext")
lines = Array[String](["I am ready, captain! I saw the Count take the tolls in Bari."])

[sub_resource type="Resource" id="witnesses_source_2"]
script = ExtResource("12_ext")
item = ExtResource("6_ext")
port = ExtResource("7_ext")
person = ExtResource("8_ext")
lines = Array[String](["I knew Bepi when he was a young copyist.", "I will tell the judges, captain."])

[sub_resource type="Resource" id="witnesses_source_3"]
script = ExtResource("12_ext")
item = ExtResource("9_ext")
port = ExtResource("10_ext")
person = ExtResource("11_ext")
lines = Array[String](["I will tell the judges how the Count hoarded the oil."])

[sub_resource type="Resource" id="witnesses"]
script = ExtResource("25_ext")
id = "witnesses"
sources = Array[ExtResource("12_ext")]([SubResource("witnesses_source_1"), SubResource("witnesses_source_2"), SubResource("witnesses_source_3")])
needed = 0
objective = "Pick up {count} more {count|witness|witnesses}."

[sub_resource type="Resource" id="charter"]
script = ExtResource("26_ext")
id = "charter"
item = ExtResource("13_ext")
port = ExtResource("14_ext")
recipient = ExtResource("15_ext")
objective = "Bring the proofs and the witnesses to {port}."
thanks = Array[String](["So this is the Golden Charter. Show me your proofs, captain."])

[sub_resource type="Resource" id="paper"]
script = ExtResource("26_ext")
id = "paper"
item = ExtResource("16_ext")
port = ExtResource("14_ext")
recipient = ExtResource("15_ext")
objective = "Bring the proofs and the witnesses to {port}."
thanks = Array[String](["The watermark of Fabriano: this paper is new, not twenty years old."])

[sub_resource type="Resource" id="seal"]
script = ExtResource("26_ext")
id = "seal"
item = ExtResource("17_ext")
port = ExtResource("14_ext")
recipient = ExtResource("15_ext")
objective = "Bring the proofs and the witnesses to {port}."
thanks = Array[String](["A seal with the name of the King spelt wrong!"])

[sub_resource type="Resource" id="letters"]
script = ExtResource("26_ext")
id = "letters"
item = ExtResource("18_ext")
port = ExtResource("14_ext")
recipient = ExtResource("15_ext")
objective = "Bring the proofs and the witnesses to {port}."
thanks = Array[String](["And the same hand wrote these letters and the charter."])

[sub_resource type="Resource" id="hearing_question_1"]
script = ExtResource("19_ext")
question = "What did the paper show against the light?"
answers = Array[String](["The watermark of Fabriano", "A map of the coast", "A picture of the Count"])
correct = 0

[sub_resource type="Resource" id="hearing_question_2"]
script = ExtResource("19_ext")
question = "Who carved the Count's false seal?"
answers = Array[String](["Brother Romualdo", "Mastro Nunzio", "Luka"])
correct = 1

[sub_resource type="Resource" id="hearing_question_3"]
script = ExtResource("19_ext")
question = "Where were Bepi's old letters hidden?"
answers = Array[String](["In the Arena of Pula", "In the palace of the Doge", "Under the white rock of Vieste"])
correct = 2

[sub_resource type="Resource" id="hearing_question_4"]
script = ExtResource("19_ext")
question = "So who is \"Count Malvento\" really?"
answers = Array[String](["A real count", "Bepi Sgorbio, a copyist", "The King of Naples"])
correct = 1

[sub_resource type="Resource" id="hearing"]
script = ExtResource("27_ext")
id = "hearing"
speaker = ExtResource("15_ext")
intro = Array[String](["The Royal Audience has seen the proofs. Now, answer my questions."])
questions = Array[ExtResource("19_ext")]([SubResource("hearing_question_1"), SubResource("hearing_question_2"), SubResource("hearing_question_3"), SubResource("hearing_question_4")])
wrong_line = "Hmm, no. Think about your voyage, captain."
right_lines = Array[String](["The court has heard enough. \"Count Malvento\" is Bepi Sgorbio, a copyist.", "He forged his title and his charter. He pays back every toll, and he is a count no more.", "And for one year, he will copy the papers of this court. Honestly!"])

[sub_resource type="Resource" id="celebration"]
script = ExtResource("28_ext")
id = "celebration"
speaker = ExtResource("5_ext")
lines = Array[String](["The fishermen land their catch for free again, from Comacchio to Otranto!", "Baba Stana sent a pigeon: \"Well done, captain!\"", "For your courage, you get the medal of the Bird Dog!"])
sound = "bell"

[resource]
script = ExtResource("1_ext")
id = "royal_audience_of_trani"
number = 25
chapter = 2
title = "The Royal Audience of Trani"
summary = "Bring the witnesses to the judges in Trani, answer their questions, and the \"Count\" is unmasked as Bepi."
start_port = ExtResource("4_ext")
clock_days = 6.0
provisions_days = 10.8
sea = ExtResource("20_ext")
steps = Array[ExtResource("21_ext")]([SubResource("briefing"), SubResource("witnesses"), SubResource("charter"), SubResource("paper"), SubResource("seal"), SubResource("letters"), SubResource("hearing"), SubResource("celebration")])
start_cargo = Array[ExtResource("22_ext")]([ExtResource("16_ext"), ExtResource("17_ext"), ExtResource("18_ext"), ExtResource("13_ext")])
fun_fact = "From 1586 on, the Royal Audience, a high court of the Kingdom of Naples, sat in Trani. Its judges heard the cases of the whole land of Bari."
victory_title = "The Count is unmasked!"
victory_lines = Array[String](["\"Count Malvento\" was only Bepi Sgorbio, and he pays back every toll.", "The whole coast of Italy cheers for the crew!"])
victory_picture = ExtResource("23_ext")
victory_person = ExtResource("5_ext")
finale = true
