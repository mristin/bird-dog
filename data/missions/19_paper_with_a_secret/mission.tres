[sub_resource type="Resource" id="briefing"]
script = ExtResource("22_ext")
id = "briefing"
speaker = ExtResource("2_ext")
lines = Array[String](["Captain, the Count's toll man left behind a page of the Count's charter.", "The Count says it is twenty years old. A paper merchant could tell!", "Ser Anselmo of Fabriano sails along the coast. Find him!"])

[sub_resource type="Resource" id="trail"]
script = ExtResource("23_ext")
id = "trail"
ports = Array[ExtResource("8_ext")]([ExtResource("3_ext"), ExtResource("4_ext"), ExtResource("5_ext"), ExtResource("6_ext"), ExtResource("7_ext")])
length = 3
fixed_route = false
max_route_km = 400.0
max_difficulty = 2
clue_templates = Array[String](["He asked the way to {fact}.", "He sailed on toward {fact}.", "I heard him talk about {fact}."])
reveal = Array[ExtResource("12_ext")]([ExtResource("9_ext"), ExtResource("10_ext"), ExtResource("11_ext")])
hallmark_template = "The paper merchant has {hallmark}."
question = "Have you seen Ser Anselmo, the paper merchant?"
found_line = "He is here, at the market! But which one is he?"

[sub_resource type="Resource" id="lineup"]
script = ExtResource("24_ext")
id = "lineup"
target = ExtResource("13_ext")
decoys = Array[Resource]([ExtResource("14_ext"), ExtResource("15_ext")])
question = "Which one is Ser Anselmo? Remember what the people told you!"
wrong_line = "No, that is not Ser Anselmo! Think of everything you heard."
right_line = "\"A paper with a secret? Take me to it, captain!\""
gives = ExtResource("16_ext")

[sub_resource type="Resource" id="ancona"]
script = ExtResource("25_ext")
id = "ancona"
item = ExtResource("16_ext")
port = ExtResource("17_ext")
recipient = ExtResource("2_ext")
objective = "Bring Ser Anselmo to {port}."
thanks = Array[String](["Ser Anselmo holds the page against the light.", "\"See the watermark? This paper was made in Fabriano only this year!\"", "So it can not be twenty years old. That is our first proof!"])
gives = ExtResource("18_ext")

[sub_resource type="Resource" id="celebration"]
script = ExtResource("26_ext")
id = "celebration"
speaker = ExtResource("13_ext")
lines = Array[String](["A watermark never lies, captain.", "The Count can forge words, but not the paper of Fabriano!"])

[resource]
script = ExtResource("1_ext")
id = "paper_with_a_secret"
number = 19
chapter = 2
title = "The Paper with a Secret"
summary = "Find the paper merchant who can read the charter against the light. Proof 1: the watermark of Fabriano."
start_port = ExtResource("17_ext")
clock_days = 12.0
provisions_days = 10.8
sea = ExtResource("19_ext")
steps = Array[ExtResource("20_ext")]([SubResource("briefing"), SubResource("trail"), SubResource("lineup"), SubResource("ancona"), SubResource("celebration")])
fun_fact = "The paper mills of Fabriano were among the first in Europe. Their papermakers invented the watermark: a picture inside the paper, which shows only against the light."
victory_title = "The first proof!"
victory_lines = Array[String](["You found Ser Anselmo, and the watermark speaks.", "The Count's paper is new, not twenty years old."])
victory_picture = ExtResource("21_ext")
victory_person = ExtResource("13_ext")
