[sub_resource type="Resource" id="briefing"]
script = ExtResource("5_ext")
id = "briefing"
speaker = ExtResource("4_ext")
lines = Array[String](["Captain, a fever spreads in the villages around the Bay of Kotor!", "Only Doctor Marin of Ragusa knows how to stop it.", "He goes from patient to patient along the coast. Find him!"])
by_pigeon = true

[sub_resource type="Resource" id="trail"]
script = ExtResource("15_ext")
id = "trail"
ports = Array[ExtResource("10_ext")]([ExtResource("6_ext"), ExtResource("7_ext"), ExtResource("8_ext"), ExtResource("9_ext"), ExtResource("pool_hvar"), ExtResource("pool_ulcinj")])
length = 3
fixed_route = false
max_route_km = 380.0
max_difficulty = 2
clue_templates = Array[String](["He asked the way to {fact}.", "He sailed on toward {fact}.", "I heard him talk about {fact}."])
reveal = Array[ExtResource("14_ext")]([ExtResource("11_ext"), ExtResource("12_ext"), ExtResource("13_ext")])
hallmark_template = "The doctor wore {hallmark}."
question = "Have you seen Doctor Marin?"
found_line = "He is here, visiting a patient! But which one is the doctor?"

[sub_resource type="Resource" id="lineup"]
script = ExtResource("19_ext")
id = "lineup"
target = ExtResource("16_ext")
decoys = Array[Resource]([ExtResource("17_ext"), ExtResource("18_ext")])
question = "Which one is Doctor Marin?"
wrong_line = "No, that is not the doctor! Remember what the people told you."
right_line = "\"Kotor needs me? Then hurry to the apothecary of the Franciscans in Dubrovnik for my medicine!\""

[sub_resource type="Resource" id="medicine_source_1"]
script = ExtResource("22_ext")
item = ExtResource("20_ext")
port = ExtResource("8_ext")
person = ExtResource("21_ext")
lines = Array[String](["Doctor Marin sent you? Here is the medicine, made by our brothers.", "Hurry to Kotor, and steer carefully through the narrow strait!"])

[sub_resource type="Resource" id="medicine"]
script = ExtResource("23_ext")
id = "medicine"
sources = Array[ExtResource("22_ext")]([SubResource("medicine_source_1")])
needed = 0
objective = "Fetch the medicine."

[sub_resource type="Resource" id="deliver"]
script = ExtResource("26_ext")
id = "deliver"
item = ExtResource("20_ext")
port = ExtResource("24_ext")
recipient = ExtResource("25_ext")
objective = "Bring the medicine to {port}."
thanks = Array[String](["The medicine! Thank you, captain!", "Now our children will get well again."])

[sub_resource type="Resource" id="celebration"]
script = ExtResource("27_ext")
id = "celebration"
speaker = ExtResource("25_ext")
lines = Array[String](["The fever is gone from the Bay of Kotor!", "The bells of St. Tryphon ring for you, captain."])

[resource]
script = ExtResource("1_ext")
id = "doctor_of_ragusa"
number = 6
chapter = 1
title = "The Doctor of Ragusa"
summary = "A fever spreads around the Bay of Kotor. Find Doctor Marin and bring his medicine."
start_port = ExtResource("2_ext")
clock_days = 13.0
provisions_days = 10.8
sea = ExtResource("3_ext")
steps = Array[ExtResource("29_ext")]([SubResource("briefing"), SubResource("trail"), SubResource("lineup"), SubResource("medicine"), SubResource("deliver"), SubResource("celebration")])
fun_fact = "In 1377, Ragusa was the first city to keep travellers apart for a while before they could enter: a quarantine, against the illnesses. The pharmacy of the Franciscans in Dubrovnik, from 1317, still sells medicine today."
victory_title = "The fever is gone!"
victory_lines = Array[String](["Doctor Marin's medicine reached Kotor just in time.", "The children of the bay are well again."])
victory_picture = ExtResource("28_ext")
victory_person = ExtResource("16_ext")
