[ext_resource type="Resource" path="res://data/world/people/joiner.tres" id="18_ext"]
[ext_resource type="Resource" path="res://data/world/people/cooper.tres" id="19_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/lineup_step.gd" id="20_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/deliver_step.gd" id="21_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/celebration_step.gd" id="22_ext"]
