[ext_resource type="Resource" path="res://data/world/items/witness_mustafa.tres" id="8_ext"]
[ext_resource type="Resource" path="res://data/world/ports/herceg_novi.tres" id="9_ext"]
[ext_resource type="Resource" path="res://data/world/people/mustafa.tres" id="10_ext"]
[ext_resource type="Resource" path="res://data/world/items/witness_jele.tres" id="11_ext"]
[ext_resource type="Resource" path="res://data/world/ports/kotor.tres" id="12_ext"]
[ext_resource type="Resource" path="res://data/world/people/olive_woman.tres" id="13_ext"]
[ext_resource type="Script" path="res://scenes/missions/steps/collect_step.gd" id="14_ext"]
