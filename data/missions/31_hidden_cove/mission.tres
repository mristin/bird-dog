[sub_resource type="Resource" id="source_1"]
script = ExtResource("2_ext")
item = ExtResource("3_ext")
port = ExtResource("4_ext")
person = ExtResource("5_ext")
lines = Array[String](["Uskok coats from the cove, all brand-new!", "Take them, captain."])

[sub_resource type="Resource" id="source_2"]
script = ExtResource("2_ext")
item = ExtResource("6_ext")
port = ExtResource("7_ext")
person = ExtResource("8_ext")
lines = Array[String](["Flags with the uskok sign, never touched by the wind.", "They washed up below my quarry."])

[sub_resource type="Resource" id="source_3"]
script = ExtResource("2_ext")
item = ExtResource("9_ext")
port = ExtResource("10_ext")
person = ExtResource("11_ext")
lines = Array[String](["Bales of Venetian cloth, hidden in the cave of my sheep!", "This is the stolen cargo."])

[sub_resource type="Resource" id="briefing"]
script = ExtResource("12_ext")
id = "briefing"
speaker = ExtResource("5_ext")
lines = Array[String](["Captain, the cove is empty, but the false uskoks left in a hurry.", "The people of the islands found their things. Collect them all!"])

[sub_resource type="Resource" id="collect"]
script = ExtResource("13_ext")
id = "collect"
sources = Array[ExtResource("2_ext")]([SubResource("source_1"), SubResource("source_2"), SubResource("source_3")])
needed = 0
objective = "Collect {count} more {count|thing|things} from the hideout."

[sub_resource type="Resource" id="costumes"]
script = ExtResource("14_ext")
id = "costumes"
item = ExtResource("3_ext")
port = ExtResource("15_ext")
recipient = ExtResource("16_ext")
objective = "Bring everything to Juraj in {port}."
thanks = Array[String](["Look at these coats! Not one of us ever wore them."])

[sub_resource type="Resource" id="flags"]
script = ExtResource("14_ext")
id = "flags"
item = ExtResource("6_ext")
port = ExtResource("15_ext")
recipient = ExtResource("16_ext")
objective = "Bring everything to Juraj in {port}."
thanks = Array[String](["And false flags! They were sewn last month."])

[sub_resource type="Resource" id="cargo"]
script = ExtResource("14_ext")
id = "cargo"
item = ExtResource("9_ext")
port = ExtResource("15_ext")
recipient = ExtResource("16_ext")
objective = "Bring everything to Juraj in {port}."
thanks = Array[String](["The cloth of the Venetian ships! We will give it back."])

[sub_resource type="Resource" id="celebration"]
script = ExtResource("17_ext")
id = "celebration"
speaker = ExtResource("18_ext")
lines = Array[String](["Costumes, flags and the stolen cloth: a whole chest of proof!", "Now we only need to know who paid for it all."])

[resource]
script = ExtResource("1_ext")
id = "hidden_cove"
number = 31
chapter = 3
title = "The Hidden Cove"
summary = "The hideout of the false uskoks is empty. Collect what they left behind on the islands."
start_port = ExtResource("4_ext")
clock_days = 3.0
provisions_days = 10.8
sea = ExtResource("19_ext")
steps = Array[ExtResource("20_ext")]([SubResource("briefing"), SubResource("collect"), SubResource("costumes"), SubResource("flags"), SubResource("cargo"), SubResource("celebration")])
fun_fact = "The canal of Osor was dug already in Roman times. Boats still sail through it between Cres and Lošinj, under a bridge which swings aside."
victory_title = "The proofs are in Senj!"
victory_lines = Array[String](["You collected the costumes, the flags and the stolen cloth.", "Juraj keeps them safe in the Nehaj fortress."])
victory_picture = ExtResource("21_ext")
victory_person = ExtResource("16_ext")
