[sub_resource type="Resource" id="source_1"]
script = ExtResource("2_ext")
item = ExtResource("3_ext")
port = ExtResource("4_ext")
person = ExtResource("5_ext")
lines = Array[String](["I'll come, bura or no bura!"])

[sub_resource type="Resource" id="source_2"]
script = ExtResource("2_ext")
item = ExtResource("6_ext")
port = ExtResource("7_ext")
person = ExtResource("8_ext")
lines = Array[String](["The Lord gave us the bura, and the captain to sail in it.", "Let's go!"])

[sub_resource type="Resource" id="source_3"]
script = ExtResource("2_ext")
item = ExtResource("9_ext")
port = ExtResource("10_ext")
person = ExtResource("11_ext")
lines = Array[String](["I have counted the Baron's planks. Every one is fresh oak!"])

[sub_resource type="Resource" id="briefing"]
script = ExtResource("12_ext")
id = "briefing"
speaker = ExtResource("13_ext")
lines = Array[String](["Captain, the meeting in Rijeka is soon!", "Bring the witnesses: Juraj, Brother Ambroz on Krk and Master Ivan in Bakar.", "But hold on tight: the bura is blowing hard today."])

[sub_resource type="Resource" id="collect"]
script = ExtResource("14_ext")
id = "collect"
sources = Array[ExtResource("2_ext")]([SubResource("source_1"), SubResource("source_2"), SubResource("source_3")])
needed = 0
objective = "Pick up {count} more {count|witness|witnesses}."

[sub_resource type="Resource" id="juraj"]
script = ExtResource("15_ext")
id = "juraj"
item = ExtResource("3_ext")
port = ExtResource("16_ext")
recipient = ExtResource("17_ext")
objective = "Bring the witnesses to the commissioner in {port}."
thanks = Array[String](["An uskok captain, here of his own free will. Welcome."])

[sub_resource type="Resource" id="friar"]
script = ExtResource("15_ext")
id = "friar"
item = ExtResource("6_ext")
port = ExtResource("16_ext")
recipient = ExtResource("17_ext")
objective = "Bring the witnesses to the commissioner in {port}."
thanks = Array[String](["A friar of Košljun. Your word weighs much, brother."])

[sub_resource type="Resource" id="ivan"]
script = ExtResource("15_ext")
id = "ivan"
item = ExtResource("9_ext")
port = ExtResource("16_ext")
recipient = ExtResource("17_ext")
objective = "Bring the witnesses to the commissioner in {port}."
thanks = Array[String](["And the shipwright who reads wood. Tomorrow, we meet."])

[sub_resource type="Resource" id="celebration"]
script = ExtResource("18_ext")
id = "celebration"
speaker = ExtResource("5_ext")
lines = Array[String](["We sailed through the hardest bura of the year!", "Tomorrow, the truth comes out."])

[resource]
script = ExtResource("1_ext")
id = "through_the_bura"
number = 34
chapter = 3
title = "Through the Bura"
summary = "The hardest bura of all. Bring Juraj, the friar and Master Ivan to the meeting in Rijeka."
start_port = ExtResource("4_ext")
clock_days = 3.0
provisions_days = 10.8
sea = ExtResource("19_ext")
steps = Array[ExtResource("20_ext")]([SubResource("briefing"), SubResource("collect"), SubResource("juraj"), SubResource("friar"), SubResource("ivan"), SubResource("celebration")])
fun_fact = "The bura falls cold from the Velebit mountains onto the sea. Near Senj, its gusts can blow faster than 200 kilometres an hour."
victory_title = "Through the bura!"
victory_lines = Array[String](["You brought every witness to Rijeka, through the hardest bura.", "The commissioner and the envoy are ready."])
victory_picture = ExtResource("21_ext")
victory_person = ExtResource("5_ext")
