#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Get on all fours: hands under the shoulders, knees under the hips."
msgstr ""
"{crew|Ponte|Ponte|Poneos} a cuatro patas: manos bajo los hombros, rodillas bajo las caderas."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Keep your back flat, like a table."
msgstr "{crew|Mantén|Mantén|Mantened} la espalda recta, como una mesa."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look at the floor, a little ahead of your hands."
msgstr "{crew|Mira|Mira|Mirad} al suelo, un poco por delante de las manos."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stretch one arm forward and the opposite leg back."
msgstr "{crew|Estira|Estira|Estirad} un brazo hacia delante y la pierna contraria hacia atrás."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hold still: belly tight, hips level."
msgstr ""
"{crew|Aguanta|Aguanta|Aguantad} sin {crew|moverte|moverte|moveros}: tripa firme, caderas rectas."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Then slowly back..."
msgstr "Luego, despacio, {crew|vuelve|vuelve|volved}..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...y ahora el otro brazo con la otra pierna."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "No {crew|dejes|dejes|dejéis} que la espalda se hunda..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...{crew|mantenla|mantenla|mantenedla} recta."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't throw your head up..."
msgstr "No {crew|levantes|levantes|levantéis} la cabeza..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...look at the floor."
msgstr "...{crew|mira|mira|mirad} al suelo."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your hip roll open..."
msgstr "No {crew|dejes|dejes|dejéis} que la cadera se abra..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep your hips level."
msgstr "...{crew|mantén|mantén|mantened} las caderas rectas."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't kick your leg up too high..."
msgstr "No {crew|subas|subas|subáis} la pierna demasiado..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...level with your back is enough."
msgstr "...a la altura de la espalda basta."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Not fast and jerky..."
msgstr "Ni rápido ni a tirones..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...but slow and calm."
msgstr "...sino lento y tranquilo."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "2/2  How you steer the boat"
msgstr "2/2  Cómo {crew|manejas|manejas|manejáis} el barco"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look: this is you, as the camera sees you."
msgstr "{crew|Mira: así te ve|Mira: así te ve|Mirad: así os ve} la cámara."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The arm on the left lifts the wheel on the left: the boat turns right."
msgstr "El brazo de la izquierda sube el timón de la izquierda: el barco gira a la derecha."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The arm on the right lifts the wheel on the right: the boat turns left."
msgstr "El brazo de la derecha sube el timón de la derecha: el barco gira a la izquierda."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The higher the arm, the harder the turn."
msgstr "Cuanto más alto el brazo, más gira el barco."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hands down, and the boat keeps its course."
msgstr "Manos abajo, y el barco sigue su rumbo."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The wind moves the boat. Against the wind, it is slow..."
msgstr "El viento mueve el barco. Contra el viento, va despacio..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...so zig-zag: left, right, left, right!"
msgstr "...así que en zigzag: ¡izquierda, derecha, izquierda, derecha!"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Both arms up at once does nothing."
msgstr "Los dos brazos arriba a la vez no hacen nada."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "One arm at a time!"
msgstr "¡Un brazo cada vez!"

