#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
#, fuzzy
msgid "I saw the Aga's men take a tax twice, right at sea."
msgstr "Vi os homens do Aga cobrarem um imposto duas vezes, ali mesmo no mar."

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
#, fuzzy
msgid "I keep the gate of Castelnuovo."
msgstr "Eu guardo a porta de Castelnuovo."

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
#, fuzzy
msgid "Every cart of the Aga's men went through it, twice."
