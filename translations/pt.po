#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...e agora o outro braço com a outra perna."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "Não {crew|deixes|deixes|deixem} as costas descair..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...{crew|mantém-nas|mantém-nas|mantenham-nas} direitas."

#: scenes/instruction/instruction.gd
