#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The higher the arm, the harder the turn."
msgstr "Quanto mais alto o braço, mais apertada a curva."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hands down, and the boat keeps its course."
msgstr "Mãos em baixo, e o barco mantém o rumo."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The wind moves the boat. Against the wind, it is slow..."
msgstr "O vento empurra o barco. Contra o vento, vai devagar..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...so zig-zag: left, right, left, right!"
msgstr "...por isso, em ziguezague: esquerda, direita, esquerda, direita!"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Both arms up at once does nothing."
msgstr "Levantar os dois braços ao mesmo tempo não faz nada."

#: scenes/instruction/instruction.gd
#, fuzzy
