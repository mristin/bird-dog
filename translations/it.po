#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The higher the arm, the harder the turn."
msgstr "Più alto è il braccio, più forte gira la barca."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hands down, and the boat keeps its course."
msgstr "Mani giù, e la barca tiene la rotta."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The wind moves the boat. Against the wind, it is slow..."
msgstr "Il vento spinge la barca. Contro vento va piano..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...so zig-zag: left, right, left, right!"
msgstr "...quindi a zigzag: sinistra, destra, sinistra, destra!"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Both arms up at once does nothing."
msgstr "Alzare tutte e due le braccia insieme non serve a niente."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "One arm at a time!"
msgstr "Un braccio alla volta!"

