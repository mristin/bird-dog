#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
#, fuzzy
msgid "Fine baskets! Here are the oranges, captain."
msgstr "Che bei cesti! Ecco le arance, {crew|capitano|capitana|capitani|capitane}."

#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
#, fuzzy
msgid "Smell them: the sun of Parga is inside."
