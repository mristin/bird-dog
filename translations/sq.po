#. a line after the right pick
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
#, fuzzy
msgid "\"I only wanted to see the sea of Italy! Take me home, please.\""
msgstr "\"Desha vetëm të shihja detin e Italisë! Më çoni në shtëpi, ju lutem.\""

#. the objective while sailing, on the banner
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
#, fuzzy
msgid "Bring the pilgrims and Luka home to {port}."
