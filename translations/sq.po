#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
#, fuzzy
msgid "Master Ivan waits in Parga, and Doctor Marin is here in Corfu."
msgstr "Mjeshtri Ivan pret në Pargë dhe doktor Marin është këtu, në Korfuz."

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
#, fuzzy
msgid "I am ready, captain. I will tell the judge about the fever."
msgstr "Jam gati, {crew|kapiten|kapitene|kapitenë|kapitene}. Do t'i tregoj gjykatësit për ethet."

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
#, fuzzy
msgid "Captain! I came all the way from Pula."
msgstr "{crew|Kapiten|Kapitene|Kapitenë|Kapitene}! Erdha që nga Pula."

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
#, fuzzy
msgid "I will tell the judge about the Aga's recruiter."
msgstr "Do t'i tregoj gjykatësit për rekrutuesin e Agait."

#. the objective while sailing, on the banner
#: data/missions/15_kadi_of_preveza/mission.tres
#, fuzzy
msgid "Bring the ledger and the witnesses to {port}."
