#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Ahoy, captain! Let's learn the bird dog."
msgstr "Ohoj, {crew|kapiten|kapitene|kapitenë|kapitene}! Le të mësojmë ushtrimin bird dog."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Get on all fours: hands under the shoulders, knees under the hips."
msgstr "{crew|Vihu|Vihu|Vihuni} në të katra: duart nën shpatulla, gjunjët nën ijë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Keep your back flat, like a table."
msgstr "{crew|Mbaje|Mbaje|Mbajeni} shpinën të sheshtë, si një tavolinë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look at the floor, a little ahead of your hands."
msgstr "{crew|Shiko|Shiko|Shikoni} dyshemenë, pak përpara duarve."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stretch one arm forward and the opposite leg back."
msgstr "{crew|Shtrije|Shtrije|Shtrijeni} njërin krah përpara dhe këmbën e kundërt prapa."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hold still: belly tight, hips level."
msgstr "{crew|Qëndro|Qëndro|Qëndroni} pa lëvizur: barku i shtrënguar, ijet drejt."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Then slowly back..."
msgstr "Pastaj ngadalë prapa..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...dhe krahu tjetër me këmbën tjetër."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "Mos e {crew|lër|lër|lini} shpinën të bjerë poshtë..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...{crew|mbaje|mbaje|mbajeni} të sheshtë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't throw your head up..."
msgstr "Mos e {crew|ngri|ngri|ngrini} kokën lart..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...look at the floor."
msgstr "...{crew|shiko|shiko|shikoni} dyshemenë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your hip roll open..."
msgstr "Mos e {crew|lër|lër|lini} ijën të kthehet anash..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep your hips level."
msgstr "...{crew|mbaji|mbaji|mbajini} ijet drejt."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't kick your leg up too high..."
msgstr "Mos e {crew|ngri|ngri|ngrini} këmbën shumë lart..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...level with your back is enough."
msgstr "...mjafton në një vijë me shpinën."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Not fast and jerky..."
msgstr "Jo shpejt e me hope..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...but slow and calm."
msgstr "...por ngadalë dhe qetë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "2/2  How you steer the boat"
msgstr "2/2  Si e {crew|drejton|drejton|drejtoni} barkën"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look: this is you, as the camera sees you."
msgstr ""
"{crew|Shiko: ky je ti, siç të sheh|Shiko: kjo je ti, siç të sheh|Shikoni: këta jeni ju, siç ju "
"sheh|Shikoni: këto jeni ju, siç ju sheh} kamera."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The arm on the left lifts the wheel on the left: the boat turns right."
msgstr "Krahu në të majtë ngre timonin në të majtë: barka kthehet djathtas."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The arm on the right lifts the wheel on the right: the boat turns left."
msgstr "Krahu në të djathtë ngre timonin në të djathtë: barka kthehet majtas."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The higher the arm, the harder the turn."
msgstr "Sa më lart krahu, aq më fort kthehet barka."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hands down, and the boat keeps its course."
msgstr "Duart poshtë dhe barka mban drejtimin."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "The wind moves the boat. Against the wind, it is slow..."
msgstr "Era e shtyn barkën. Kundër erës ecën ngadalë..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...so zig-zag: left, right, left, right!"
msgstr "...prandaj zigzag: majtas, djathtas, majtas, djathtas!"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Both arms up at once does nothing."
msgstr "Të dy krahët lart njëherësh nuk bëjnë asgjë."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "One arm at a time!"
msgstr "Njëri krah pas tjetrit!"

