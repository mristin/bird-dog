#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
#, fuzzy
msgid "The bura blows, and the salt is safe in the villages!"
msgstr "Puše bura, a sol je na sigurnon u selima!"

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
#, fuzzy
msgid "Tonight we dance in Senj, captain!"
msgstr "Večeras se u Senju pleše, {crew|kapetane|kapetanice|kapetani|kapetanice}!"

#. the title of a mission, on its card
#: data/missions/03_salt_for_the_winter/mission.tres
#, fuzzy
msgid "Salt for the Winter"
