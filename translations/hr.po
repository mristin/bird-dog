#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Get on all fours: hands under the shoulders, knees under the hips."
msgstr "{crew|Stani|Stani|Stanite} na sve četiri: ruke ispod ramena, kolina ispod kukova."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Keep your back flat, like a table."
msgstr "Leđa ravna, ka stol."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look at the floor, a little ahead of your hands."
msgstr "{crew|Gledaj|Gledaj|Gledajte} u pod, malo ispred ruku."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stretch one arm forward and the opposite leg back."
msgstr "{crew|Ispruži|Ispruži|Ispružite} jednu ruku naprid, a suprotnu nogu nazad."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hold still: belly tight, hips level."
msgstr "{crew|Stoj|Stoj|Stojte} mirno: trbuh stisnut, kukovi ravno."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Then slowly back..."
msgstr "Onda lagano nazad..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...pa druga ruka s drugon nogon."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "{crew|Pazi da ti|Pazi da ti|Pazite da van} leđa ne propadnu..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...{crew|drži|drži|držite} ih ravno."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't throw your head up..."
msgstr "{crew|Nemoj|Nemoj|Nemojte} dizat glavu..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...look at the floor."
msgstr "...{crew|gledaj|gledaj|gledajte} u pod."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your hip roll open..."
msgstr "{crew|Pazi da ti|Pazi da ti|Pazite da van} se kuk ne otvori..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep your hips level."
msgstr "...{crew|drži|drži|držite} kukove ravno."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't kick your leg up too high..."
msgstr "{crew|Nemoj|Nemoj|Nemojte} dizat nogu previsoko..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...level with your back is enough."
msgstr "...dosta je u ravnini s leđima."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Not fast and jerky..."
