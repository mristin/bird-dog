#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
#, fuzzy
msgid "\"His men even took the eel nets of Comacchio as a toll. Please help!\""
msgstr ""
"„Njegovi ljudi su uzeli čak i mriže za jegulje iz Comacchija, ka pristojbu. "
"{crew|Pomozi|Pomozi|Pomozite}!”"

#. what the crew asks, or what the crew is asked
#: data/missions/16_nets_of_comacchio/mission.tres
#, fuzzy
msgid "Have you seen the Count's men with the eel nets?"
msgstr "Jeste li vidili Grofove ljude s mrižama za jegulje?"

#. what the crew asks, or what the crew is asked
#: data/missions/16_nets_of_comacchio/mission.tres
#, fuzzy
msgid "Which boat is the Count's? Remember its sail and its hull!"
msgstr "Koja je Grofova brodica? {crew|Spomeni se|Spomeni se|Spomenite se} idra i trupa!"

#. a line after a wrong pick
#: data/missions/16_nets_of_comacchio/mission.tres data/missions/26_caps_too_new/mission.tres
#, fuzzy
msgid "No, not this one! Think of the sail and the hull."
