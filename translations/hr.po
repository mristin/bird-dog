msgstr "{crew|Pozdravi|Pozdravi|Pozdravite} mi meštra Ivana!"

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
#, fuzzy
msgid "A mast from the firs of Velebit, straight as an arrow!"
msgstr "Jarbol od jela s Velebita, ravan ka strila!"

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
#, fuzzy
msgid "The bura made them strong."
msgstr "Bura ih je napravila jakima."

#. the objective while sailing, on the banner
#: data/missions/04_oak_for_master_ivan/mission.tres
#, fuzzy
