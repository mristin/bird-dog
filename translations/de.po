#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Get on all fours: hands under the shoulders, knees under the hips."
msgstr ""
"{crew|Geh|Geh|Geht} in den Vierfüßlerstand: Hände unter die Schultern, Knie unter die Hüften."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Keep your back flat, like a table."
msgstr "{crew|Halte|Halte|Haltet} den Rücken gerade wie eine Tischplatte."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look at the floor, a little ahead of your hands."
msgstr ""
"{crew|Schau auf den Boden, ein Stück vor deine Hände.|Schau auf den Boden, ein Stück vor deine "
"Hände.|Schaut auf den Boden, ein Stück vor eure Hände.}"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stretch one arm forward and the opposite leg back."
msgstr ""
"{crew|Streck|Streck|Streckt} einen Arm nach vorn und das gegenüberliegende Bein nach hinten."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hold still: belly tight, hips level."
msgstr "{crew|Halte|Halte|Haltet} still: Bauch fest, Hüften gerade."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Then slowly back..."
msgstr "Dann langsam zurück..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...und der andere Arm mit dem anderen Bein."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "{crew|Lass|Lass|Lasst} den Rücken nicht durchhängen..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...{crew|halte|halte|haltet} ihn flach."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't throw your head up..."
msgstr "{crew|Wirf|Wirf|Werft} den Kopf nicht hoch..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...look at the floor."
msgstr "...{crew|schau|schau|schaut} auf den Boden."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your hip roll open..."
msgstr "{crew|Lass|Lass|Lasst} die Hüfte nicht zur Seite kippen..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep your hips level."
msgstr "...{crew|halte|halte|haltet} die Hüften gerade."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't kick your leg up too high..."
msgstr "{crew|Schwing|Schwing|Schwingt} das Bein nicht zu hoch..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...level with your back is enough."
msgstr "...auf Höhe des Rückens reicht."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Not fast and jerky..."
msgstr "Nicht schnell und ruckartig..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...but slow and calm."
msgstr "...sondern langsam und ruhig."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "2/2  How you steer the boat"
