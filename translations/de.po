#: data/missions/24_count_flees/mission.tres
#, fuzzy
msgid "\"Alright, alright! Here is the charter. It was such a beautiful charter...\""
msgstr "„Schon gut, schon gut! Hier ist die Urkunde. Es war so eine schöne Urkunde...“"

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
#, fuzzy
msgid "\"Fine, I will come before the judges in Trani.\""
msgstr "„Na gut, ich komme vor die Richter in Trani.“"

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
#, fuzzy
msgid "With the Golden Charter, the crew holds everything the judges need."
msgstr "Mit der Goldenen Urkunde hat die Mannschaft alles, was die Richter brauchen."

#. the title of a mission, on its card
#: data/missions/24_count_flees/mission.tres
#, fuzzy
