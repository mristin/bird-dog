#: data/chapters/1_the_agas_ledger.tres
msgid ""
"The greedy Aga Grdan collects double taxes with forged papers. Gather the proof and bring him "
"before the judge."
msgstr ""

#. the title of a mission, on its card
#: data/chapters/2_the_count_of_ill_wind.tres
msgid "The Count of Ill Wind"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/chapters/2_the_count_of_ill_wind.tres
msgid "A false Count takes tolls in every harbour of Italy with a forged charter. Unmask him!"
msgstr ""

#. the title of a mission, on its card
#: data/chapters/3_the_wolf_of_the_bura.tres
msgid "The Wolf of the Bura"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/chapters/3_the_wolf_of_the_bura.tres
msgid ""
"Fake uskoks rob the ships of Venice, and two empires are about to quarrel. Find who is behind it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Ahoy, captain! I have bad news from Grebaštica."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The Aga's men took the village bell as a \"tax\" and sailed off with it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "A fisherman saw them leave. Follow them!"
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/01_bell_of_grebastica/mission.tres data/missions/16_nets_of_comacchio/mission.tres
#: data/missions/26_caps_too_new/mission.tres data/missions/30_friars_of_kosljun/mission.tres
msgid "They asked the way to {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/01_bell_of_grebastica/mission.tres data/missions/16_nets_of_comacchio/mission.tres
#: data/missions/26_caps_too_new/mission.tres data/missions/30_friars_of_kosljun/mission.tres
msgid "They sailed on toward {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/01_bell_of_grebastica/mission.tres data/missions/16_nets_of_comacchio/mission.tres
#: data/missions/26_caps_too_new/mission.tres
msgid "I heard them talk about {fact}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Have you seen the Aga's men with the bell?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/01_bell_of_grebastica/mission.tres data/missions/16_nets_of_comacchio/mission.tres
#: data/missions/26_caps_too_new/mission.tres
msgid "They are here, in the harbour! But which boat is theirs?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Which boat is the Aga's? Remember its sail!"
msgstr ""

#. a line after a wrong pick
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "No, not this one! Look at the sails again."
msgstr ""

#. a line after the right pick
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "That's the one! The Aga's men grumble and give the bell back: \"It was only borrowed!\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Bring the bell home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Our bell! Thank you, captain!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Tonight it will ring over the whole bay."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "Ding, dong! The bell of Grebaštica rings again!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The whole village thanks you, captain."
msgstr ""

#. the title of a mission, on its card
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The Bell of Grebaštica"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid ""
"The Aga's men took the bell of Grebaštica as a \"tax\". Follow its trail along the coast and bring"
" it home."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/01_bell_of_grebastica/mission.tres
msgid ""
"The cathedral of St. James in Šibenik was built only of stone, without wood or bricks. Its outer "
"wall carries 71 carved heads of the people of that time."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The bell rings again!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The bell of Grebaštica is home, and it rings over the whole bay."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/01_bell_of_grebastica/mission.tres
msgid "The children wave from the stone walls."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Captain, please help me! I am Katarina, the daughter of Master Ivan."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "The Aga's recruiter wants Father to build the Aga's tax boats, so Father hid."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "He left clues which only friends understand. Start where they dance the Moreška!"
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/02_shipwright_of_korcula/mission.tres
#: data/missions/06_doctor_of_ragusa/mission.tres
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres data/missions/12_forged_ledger/mission.tres
#: data/missions/13_secret_script/mission.tres data/missions/19_paper_with_a_secret/mission.tres
#: data/missions/20_seal_maker_of_ortona/mission.tres data/missions/24_count_flees/mission.tres
#: data/missions/32_stewards_ledger/mission.tres
msgid "He asked the way to {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/02_shipwright_of_korcula/mission.tres
#: data/missions/06_doctor_of_ragusa/mission.tres
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres data/missions/12_forged_ledger/mission.tres
#: data/missions/13_secret_script/mission.tres data/missions/19_paper_with_a_secret/mission.tres
#: data/missions/20_seal_maker_of_ortona/mission.tres data/missions/24_count_flees/mission.tres
#: data/missions/32_stewards_ledger/mission.tres
msgid "He sailed on toward {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/02_shipwright_of_korcula/mission.tres
#: data/missions/06_doctor_of_ragusa/mission.tres
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres data/missions/12_forged_ledger/mission.tres
#: data/missions/13_secret_script/mission.tres data/missions/19_paper_with_a_secret/mission.tres
#: data/missions/20_seal_maker_of_ortona/mission.tres data/missions/24_count_flees/mission.tres
#: data/missions/32_stewards_ledger/mission.tres
msgid "I heard him talk about {fact}."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Master Ivan has {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Have you seen Master Ivan, the shipwright?"
msgstr ""

#. what the crew hears when a rival was first in a port; {port} is a port
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "The Aga's recruiter reached {port} first! Master Ivan fled further."
msgstr ""

#. a line in the last port of a trail
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "He is here, hiding among the workers of the harbour! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Which one is Master Ivan? Remember what his friends told you!"
msgstr ""

#. a line after a wrong pick
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "No, that is not him! Think of everything his friends said."
msgstr ""

#. a line after the right pick
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "\"You found me before the recruiter did! Take me home to my daughter.\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Bring Master Ivan safely to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Father! You are safe!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Thank you, captain. We will never forget it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Here in Pula, I will open my new shipyard."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "And your boats, captain, I will decorate for free, for ever!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "The Shipwright of Korčula"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Master Ivan hides from the Aga's recruiter. Find him first and bring him safely to Pula."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid ""
"The shipwrights of Korčula were famous all over the Adriatic, and the stonemasons of the island "
"built in Venice and in Dubrovnik."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Master Ivan is safe!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "The Aga's recruiter sails home with empty hands."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Master Ivan and Katarina are together again in Pula."
msgstr ""

#. what the crew gets from now on, at the end of a mission, one sentence
#: data/missions/02_shipwright_of_korcula/mission.tres
msgid "Master Ivan opens his shipyard in Pula: from now on, he decorates your boats."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Captain, winter is coming, and the Aga hoards all the salt."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Without salt, the villages can not keep their fish and their meat."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Fetch two loads of salt: Ragusa sells it in Ston, Venice in Pag, the Habsburgs in Trieste."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Salt from the pans of Ragusa, at a fair price!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Our walls are the longest in the land, to keep the salt safe."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The salt of Pag belongs to Venice, captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "But for the villages, I will sell you a load."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Ja, salt of the Habsburgs, white as snow!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "A long way north, but here it is."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Fetch {count} more {count|load|loads} of salt."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Bring a load of salt to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Salt! Now we can keep our fish for the winter."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
#: data/missions/10_corsairs_of_ulcinj/mission.tres data/missions/16_nets_of_comacchio/mission.tres
msgid "Thank you, captain!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Bring the other load to the villages behind {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Welcome to Senj, captain! I am Juraj, a captain of the uskoks."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The villages behind the mountains thank you for the salt."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid ""
"Listen: when the bura blows, stay close to the islands. From now on, my scouts watch the sea for "
"you."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The bura blows, and the salt is safe in the villages!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Tonight we dance in Senj, captain!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Salt for the Winter"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The Aga hoards the salt. Fetch salt and bring it to the villages before winter."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/03_salt_for_the_winter/mission.tres
msgid ""
"The walls of Ston, more than five kilometres long, were built by Ragusa to protect its salt pans, "
"which still give salt today."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Salt for everybody!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The villages can keep their fish and their meat for the winter."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "The Aga's hoard is worth nothing now."
msgstr ""

#. what the crew gets from now on, at the end of a mission, one sentence
#: data/missions/03_salt_for_the_winter/mission.tres
msgid "Juraj, the uskok captain of Senj, now scouts the sea for you."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Captain, the fishermen of Pula need new boats."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "But the Aga bought up all the oak, to build his tax boats."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Fetch me oak from Leopold in Rijeka, and a fir mast from Juraj in Senj!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "The Aga wanted all my oak, but I kept the best for honest shipwrights."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Greet Master Ivan from me!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "A mast from the firs of Velebit, straight as an arrow!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "The bura made them strong."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Fetch {count} more {count|load|loads} of wood."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Bring the oak to Master Ivan in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Beautiful oak! It still smells of the forest."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Bring the mast to Master Ivan in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "And a mast from Velebit! Now I can build."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "The first new boat is in the water!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "And the Aga's tax boats? They are still waiting for their oak."
msgstr ""

#. the title of a mission, on its card
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Oak for Master Ivan"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid ""
"The Aga bought up the oak. Fetch oak and a mast for Master Ivan, so that he can build boats for "
"the fishermen."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid ""
"Venice stands on wooden piles of alder, a wood which does not rot in the water, and its houses "
"rest on stone from Istria."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "The shipyard is busy again!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "Oak from Rijeka and a mast from Senj reached Pula."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/04_oak_for_master_ivan/mission.tres
msgid "The fishermen of Pula will sail in new boats."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Captain, a Venetian patrol caught my brother Juraj!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "They took him to Venice, as a pirate."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Collect letters from the people he helped, and speak for him before the Doge's council!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj guarded the salt for the villages, not for himself."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Here is my letter for the Doge."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj pulled my timber boat off the rocks in the bura."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Take my letter to Venice."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj always paid for his soup, every time!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Here, I wrote it down for the Doge."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Collect {count} more {count|letter|letters} for Juraj."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Bring the letters to the Doge's council in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "A letter from Pag, about the salt."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "A letter from Rijeka, about the rescue in the bura."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "And a letter from Trieste... about soup?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "What did Juraj guard for the villages?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The salt"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The gold of the Aga"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The cannons of Venice"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Which wind blows hardest at Senj?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The bura"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The jugo"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The maestral"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Who wrote that Juraj always paid for his soup?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Gertraud of Trieste"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Leopold of Rijeka"
msgstr ""

#. an answer on a button, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres data/missions/27_the_doges_ten_days/mission.tres
msgid "The Doge"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The council has read the letters. Now answer our questions, captain."
msgstr ""

#. a line after a wrong pick
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Hmm, no. Think of the letters, captain."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj is no pirate: he helps the villages."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The council sets him free!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/05_uskok_and_the_doge/mission.tres data/missions/35_peace_of_rijeka/mission.tres
msgid "Pick up Juraj in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Free at last! Thank you, captain."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Take me home to Senj, to my sister."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/05_uskok_and_the_doge/mission.tres data/missions/35_peace_of_rijeka/mission.tres
msgid "Bring Juraj home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Brother! You are home!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Home in Senj, and free!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "My scouts and I owe you, captain."
msgstr ""

#. the title of a mission, on its card
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The Uskok and the Doge"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid ""
"A Venetian patrol caught Juraj. Collect the letters of his friends and speak for him in Venice."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid ""
"The Nehaj fortress in Senj was finished in 1558 on the ruins of churches, monasteries and houses "
"outside the town walls, as a base for the uskoks."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj is free!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "The letters of his friends spoke for him before the Doge's council."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/05_uskok_and_the_doge/mission.tres
msgid "Juraj is home in Senj again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Captain, a fever spreads in the villages around the Bay of Kotor!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Only Doctor Marin of Ragusa knows how to stop it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "He goes from patient to patient along the coast. Find him!"
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The doctor wore {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Have you seen Doctor Marin?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "He is here, visiting a patient! But which one is the doctor?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Which one is Doctor Marin?"
msgstr ""

#. a line after a wrong pick
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "No, that is not the doctor! Remember what the people told you."
msgstr ""

#. a line after the right pick
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid ""
"\"Kotor needs me? Then hurry to the apothecary of the Franciscans in Dubrovnik for my medicine!\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Doctor Marin sent you? Here is the medicine, made by our brothers."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Hurry to Kotor, and steer carefully through the narrow strait!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Fetch the medicine."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Bring the medicine to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The medicine! Thank you, captain!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Now our children will get well again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The fever is gone from the Bay of Kotor!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The bells of St. Tryphon ring for you, captain."
msgstr ""

#. the title of a mission, on its card
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The Doctor of Ragusa"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "A fever spreads around the Bay of Kotor. Find Doctor Marin and bring his medicine."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid ""
"In 1377, Ragusa was the first city to keep travellers apart for a while before they could enter: a"
" quarantine, against the illnesses. The pharmacy of the Franciscans in Dubrovnik, from 1317, still"
" sells medicine today."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The fever is gone!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "Doctor Marin's medicine reached Kotor just in time."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/06_doctor_of_ragusa/mission.tres
msgid "The children of the bay are well again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Captain, Hvar opens a theatre for everybody, rich and poor!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "But the Aga's men scared my actors away, all along the coast."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Find them and bring them to Hvar before the opening night!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The Aga's men said a jester is a useless man."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Ha! I will make all of Hvar laugh."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "I hid in the cathedral and sang to the stone heads."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Now I will sing for real people again!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Old Toma never misses an opening night."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "I have a new story about a clever captain..."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Find {count} more {count|actor|actors}."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Bring the actors to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Pero! Go and put on your bells."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Dora! Your voice will fill the whole hall."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Toma! Now we have all our actors."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The curtain rises!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "Fishermen and nobles sit side by side, and everybody laughs."
msgstr ""

#. the title of a mission, on its card
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The Theatre of Hvar"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The Aga's men scared the actors away. Bring them to Hvar for the opening of the theatre."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/07_theatre_of_hvar/mission.tres
msgid ""
"Hvar's theatre opened in 1612 above the town's galley shed. It is one of the oldest public "
"theatres in Europe, paid for by the town for all the people of Hvar."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The theatre is full!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The jester, the singer and the storyteller made it to Hvar."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/07_theatre_of_hvar/mission.tres
msgid "The whole town laughs, sings and listens together."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Welcome, captain. The villages have written down everything the Aga did."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Bring their complaint to the envoy of the Pope in Ancona."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Here is my letter of recommendation. Cross the sea, and may the wind be kind!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/08_across_the_sea/mission.tres
msgid "Bring the complaint across the sea to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "A complaint about an aga? Let me read it."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/08_across_the_sea/mission.tres
msgid "Which emperor's arch stands at our harbour?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/08_across_the_sea/mission.tres
msgid "The arch of Trajan"
msgstr ""

#. an answer on a button, a few words
#: data/missions/08_across_the_sea/mission.tres
msgid "The arch of Diocletian"
msgstr ""

#. an answer on a button, a few words
#: data/missions/08_across_the_sea/mission.tres
msgid "The arch of the Doge"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "But first, tell me: are you really sailors who know our sea?"
msgstr ""

#. a line after a wrong pick
#: data/missions/08_across_the_sea/mission.tres
msgid "Hmm, no. Look around the harbour, and think again!"
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Right! You know our sea."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "But only the Viceroy's man in Bari can carry this to the court of the Sultan."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Sail to the town where they keep the bones of St. Nicholas!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/08_across_the_sea/mission.tres
msgid "Bring the complaint to the Viceroy's man in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "The envoy of the Pope sends you? Then it is serious."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Take my sealed answer back to the Rector of Ragusa."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/08_across_the_sea/mission.tres
msgid "Bring the sealed answer back to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "The answer from Bari! Let me break the seal..."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "\"The Aga shall be heard before a judge.\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Captain, the villages will have their day in court!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/08_across_the_sea/mission.tres
msgid "Across the Sea"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/08_across_the_sea/mission.tres
msgid "Bring the villages' complaint across the sea to Ancona and Bari."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/08_across_the_sea/mission.tres
msgid ""
"The bones of St. Nicholas, the saint of the sailors and of the children, were brought to Bari by "
"its sailors in 1087."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/08_across_the_sea/mission.tres
msgid "You crossed the sea!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/08_across_the_sea/mission.tres
msgid "The complaint reached the Pope's envoy and the Viceroy."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/08_across_the_sea/mission.tres
msgid "The Aga will have to face a judge."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Captain, pilgrims from Ragusa came to Bari to see St. Nicholas."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "But the Aga's men took the money for their passage home."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Take them home across the sea! But first, find little Luka, who ran off along the coast."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Luka has {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Have you seen Luka, a ship's boy from Ragusa?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Luka is here, with the ship's boys of the harbour! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Which one is Luka? Remember what the people told you!"
msgstr ""

#. a line after a wrong pick
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "No, that is not Luka! Think of everything you heard."
msgstr ""

#. a line after the right pick
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "\"I only wanted to see the sea of Italy! Take me home, please.\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Bring the pilgrims and Luka home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "The pilgrims are home! Thank you, captain."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Bring Luka home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "Luka! There you are!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "The pilgrims will tell everybody about the kind captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "And Luka? He wants to become a captain, too!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "The Pilgrims of St. Nicholas"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid ""
"The Aga's men took the pilgrims' money. Find little Luka and take them all home across the sea."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid ""
"The whole floor of Otranto cathedral is one huge mosaic, made in the 1160s by artists led by a "
"monk called Pantaleon, with a great Tree of Life running along it."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "The pilgrims are home!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "You found Luka and took the pilgrims home across the sea."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/09_pilgrims_of_st_nicholas/mission.tres
msgid "In Ragusa, the bells ring for them."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Captain! The corsairs of Ulcinj took all our olive oil."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "We traded it for the winter, and now we have nothing."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Nobody fights them. Go and ask what they want for it!"
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Oil for oil? No, no. My sail is torn to rags."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Bring me a new sail, and you get your oil back."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "The sailmaker of Durrës makes the best sails."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "A new sail! Fine work. Here is your oil, captain."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "And tell the Aga that Crooked Mast is not his friend."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "A sail? Gladly, but my cough is so bad, I can not work."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Only the honey of Vlorë helps."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Bring me a jar of honey!"
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Honey from Vlorë! My cough is gone already."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Here is the sail. The finest in the Adriatic!"
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Honey? My bees made plenty."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "But I need salt for my cheese. Do you have salt on board?"
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Salt! Just what I needed."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Here is a jar of my best honey."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Bring the olive oil home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Our oil! Now we have enough for the winter."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Crooked Mast sent a message, too:"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "\"The Aga's scribe sails south with a heavy book. Watch out for him!\""
msgstr ""

#. the title of a mission, on its card
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "The Corsairs of Ulcinj"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "The corsairs took the villages' olive oil. Find out what they want, and trade it back."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid ""
"The olive trees of the Adriatic grow very old: near Bar in Montenegro stands an olive tree which "
"is said to be more than two thousand years old."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "The oil is home!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Not a single shot was fired: a sail, a jar of honey and a sack of salt did it."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/10_corsairs_of_ulcinj/mission.tres
msgid "Even the corsair captain is your friend now."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Captain, the Aga wants the oranges of Parga as a tax!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Eleni of Parga hid the harvest from his men."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Help her get the oranges to the market of Corfu, so that the money stays with the people."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "The oranges are ripe, but the Aga's men broke all my baskets."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Bring me baskets! Ilir of Vlorë weaves the best ones."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Fine baskets! Here are the oranges, captain."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Smell them: the sun of Parga is inside."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "I weave baskets from the reeds of the lagoon."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "But my boat lost its rope. Spiros in Corfu has ropes!"
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "A good rope! Here are my baskets."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "A rope for Ilir? The harbour of Corfu has ropes for everybody."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Take this one, captain."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Bring the oranges to the market of {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Oranges from Parga! The whole market smells of them."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "The money goes to the people of Parga, not to the Aga."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Every orange was sold, and Parga keeps its money."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid "The Aga gets only the peels!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/11_oranges_of_parga/mission.tres
msgid "The Oranges of Parga"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid ""
"The Aga wants the oranges of Parga as a tax. Trade your way to baskets and bring the oranges to "
"the market of Corfu."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/11_oranges_of_parga/mission.tres
msgid ""
"Parga was a little Venetian town on the Greek coast for almost 400 years, with Ottoman lands all "
"around it, and it was often raided by its neighbours."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/11_oranges_of_parga/mission.tres
msgid "Sweet oranges for Corfu!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/11_oranges_of_parga/mission.tres
msgid "The oranges reached the market, and the money stayed in Parga."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/11_oranges_of_parga/mission.tres
msgid "A rope, a basket and a lot of sailing did it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "Captain, the warning of Crooked Mast came true!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "The Aga's scribe was here with a heavy book: the ledger of the double taxes."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "With it, we can prove everything. But he fled in a hurry. Chase him!"
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/12_forged_ledger/mission.tres
msgid "The scribe had {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/12_forged_ledger/mission.tres
msgid "Have you seen the Aga's scribe with a heavy book?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/12_forged_ledger/mission.tres data/missions/24_count_flees/mission.tres
#: data/missions/32_stewards_ledger/mission.tres
msgid "He is here, hiding among the people of the harbour! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/12_forged_ledger/mission.tres
msgid "Which one is the Aga's scribe?"
msgstr ""

#. a line after a wrong pick
#: data/missions/12_forged_ledger/mission.tres
msgid "No, that is not the scribe! Remember all four things you learned."
msgstr ""

#. a line after the right pick
#: data/missions/12_forged_ledger/mission.tres
msgid "\"Alright, alright! Here is the ledger. I only wrote what the Aga told me!\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "\"I will tell the truth before the judge, I promise.\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "The ledger proves it: the Aga took every tax twice!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/12_forged_ledger/mission.tres
msgid "The Forged Ledger"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/12_forged_ledger/mission.tres
msgid "The Aga's scribe flees with the ledger of the double taxes. Chase him along the coast!"
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/12_forged_ledger/mission.tres
msgid ""
"Spectacles were made in Venice from about 1300 on; the glassmakers of Murano were so precious that"
" they were not allowed to leave the republic."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/12_forged_ledger/mission.tres
msgid "The ledger is yours!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/12_forged_ledger/mission.tres
msgid "You chased the scribe along the whole coast and found him."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/12_forged_ledger/mission.tres
msgid "Now the crew holds the proof of the double taxes."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "Captain, I must confess something."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid ""
"I wrote the list of the villages in the old Glagolitic letters, so that the Aga could not read it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "Now I can not read it either! Find a priest who knows the old letters."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/13_secret_script/mission.tres
msgid "The priest has {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/13_secret_script/mission.tres
msgid "Have you seen a priest who knows the old letters?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/13_secret_script/mission.tres
msgid "Don Grgur is here, at the market! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/13_secret_script/mission.tres
msgid "Which one is Don Grgur? Remember what the people told you!"
msgstr ""

#. a line after a wrong pick
#: data/missions/13_secret_script/mission.tres
msgid "No, that is not him! Think of all three things you learned."
msgstr ""

#. a line after the right pick
#: data/missions/13_secret_script/mission.tres
msgid "\"Yes, I read the old letters. Let me see... every village, and every ducat!\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/13_secret_script/mission.tres
msgid "Bring the list back to the scribe in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "Every village and every ducat, written clearly at last!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "Now the judge can give back every coin."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "The list is ready for the judge."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/13_secret_script/mission.tres
msgid "I will never write in a secret script again!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/13_secret_script/mission.tres
msgid "The Secret Script"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/13_secret_script/mission.tres
msgid ""
"The list of the villages is written in old Glagolitic letters. Find a priest who can read it."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/13_secret_script/mission.tres
msgid ""
"Glagolitic is the oldest known Slavic alphabet. On the islands of Kvarner, like Krk, and on the "
"islands near Zadar, Croatian priests and scribes kept writing in it for centuries."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/13_secret_script/mission.tres
msgid "The list is read!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/13_secret_script/mission.tres
msgid "Don Grgur read the old letters for you."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/13_secret_script/mission.tres
msgid "Now the judge will know every village and every ducat."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Captain, the judge wants to hear witnesses, not only the ledger."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Crooked Mast in Ulcinj, Mustafa in Castelnuovo and Jele in Kotor saw what the Aga's men did."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Bring all three to Corfu, where the voyage to the judge begins!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Me, a witness? Ha! Fine."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "I saw the Aga's men take a tax twice, right at sea."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "I keep the gate of Castelnuovo."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Every cart of the Aga's men went through it, twice."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "They took my olives as a tax, and came back a week later for more."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "I will tell the judge everything."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/14_the_witnesses/mission.tres data/missions/15_kadi_of_preveza/mission.tres
#: data/missions/25_royal_audience_of_trani/mission.tres
#: data/missions/34_through_the_bura/mission.tres
msgid "Pick up {count} more {count|witness|witnesses}."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/14_the_witnesses/mission.tres
msgid "Bring the witnesses to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Crooked Mast? A corsair as a witness... the judge will be surprised!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Mustafa, the gatekeeper. Welcome to Corfu!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Jele of Kotor. Rest a little, the voyage is long."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "The witnesses are ready, and so is the ledger."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "Soon, the voyage to the judge begins!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/14_the_witnesses/mission.tres
msgid "The Witnesses"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/14_the_witnesses/mission.tres
msgid "The judge wants to hear witnesses. Bring them from Ulcinj, Castelnuovo and Kotor to Corfu."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/14_the_witnesses/mission.tres
msgid ""
"The Republic of Ragusa banned the slave trade in 1416. It valued freedom very highly: the word "
"Libertas stands on its flag."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/14_the_witnesses/mission.tres
msgid "The witnesses are ready!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/14_the_witnesses/mission.tres
msgid "A corsair, a gatekeeper and an olive grower will speak before the judge."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/14_the_witnesses/mission.tres
msgid "The Aga's days as a tax collector are numbered."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Captain, the day has come!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Bring the ledger and the witnesses to the kadı of Preveza: he judges by the law."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Master Ivan waits in Parga, and Doctor Marin is here in Corfu."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "I am ready, captain. I will tell the judge about the fever."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Captain! I came all the way from Pula."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "I will tell the judge about the Aga's recruiter."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Bring the ledger and the witnesses to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Peace be with you. Show me the ledger, and let the witnesses speak."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Which village lost its bell?"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/15_kadi_of_preveza/mission.tres data/world/ports/grebastica.tres
msgid "Grebaštica"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/15_kadi_of_preveza/mission.tres data/missions/30_friars_of_kosljun/mission.tres
#: data/world/ports/senj.tres
msgid "Senj"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/15_kadi_of_preveza/mission.tres data/world/ports/ston.tres
msgid "Ston"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Who hoarded the salt before the winter?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The uskoks"
msgstr ""

#. an answer on a button, a few words
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The Aga"
msgstr ""

#. an answer on a button, a few words
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The Pope"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Who stopped the fever around the Bay of Kotor?"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/15_kadi_of_preveza/mission.tres data/world/items/passenger_ivan.tres
#: data/world/people/master_ivan.tres
msgid "Master Ivan"
msgstr ""

#. an answer on a button, a few words
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Crooked Mast"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/15_kadi_of_preveza/mission.tres data/world/people/doctor_marin.tres
msgid "Doctor Marin"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "I have read the ledger. Now, answer my questions."
msgstr ""

#. a line after a wrong pick
#: data/missions/15_kadi_of_preveza/mission.tres
#: data/missions/25_royal_audience_of_trani/mission.tres
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Hmm, no. Think about your voyage, captain."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The law is clear. The Aga must give back every double tax, and he loses his post."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "He may go home and look after his goats."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/15_kadi_of_preveza/mission.tres data/missions/35_peace_of_rijeka/mission.tres
msgid "Sail home to {port}!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "You are home, captain! The whole Adriatic heard the news."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Everybody came to the Arena: the children of Grebaštica, Master Ivan and Katarina,"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Juraj, Doctor Marin, and even Crooked Mast!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres data/missions/35_peace_of_rijeka/mission.tres
msgid "Captain, for your courage you get the medal of the Bird Dog!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The Kadı of Preveza"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "Bring the ledger and the witnesses to the judge in Preveza, then sail home to Pula."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/15_kadi_of_preveza/mission.tres
msgid ""
"In the Ottoman Empire, a kadı judged by the law, and the people could bring a complaint even "
"against a powerful aga."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The voyage is complete!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The Aga gave back the double taxes, and the villages are free."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/15_kadi_of_preveza/mission.tres
msgid "The bell of Grebaštica rings, and the whole Arena of Pula cheers!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Captain, a pigeon came from Bari, with a letter from Luka, the ship's boy!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "He writes: \"A Count has come to Italy, Count Malvento. He shows a Golden Charter.\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "\"He takes a toll in every harbour, from Comacchio to Otranto!\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "\"His men even took the eel nets of Comacchio as a toll. Please help!\""
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Have you seen the Count's men with the eel nets?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Which boat is the Count's? Remember its sail and its hull!"
msgstr ""

#. a line after a wrong pick
#: data/missions/16_nets_of_comacchio/mission.tres data/missions/26_caps_too_new/mission.tres
msgid "No, not this one! Think of the sail and the hull."
msgstr ""

#. a line after the right pick
#: data/missions/16_nets_of_comacchio/mission.tres
msgid ""
"That's the one! The Count's men shrug: \"The Count says nets are a toll.\" But they give them "
"back."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Bring the eel nets home to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Our nets! Now we can catch the eels again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Tonight, the whole lagoon eats eels!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "But this Count... Nobody here ever heard of him before."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Who is he really, captain?"
msgstr ""

#. the title of a mission, on its card
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "Nets of Comacchio"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid ""
"The first crossing to Italy. The Count's men took the eel nets of Comacchio \"as a toll\". Follow "
"their boat and give the nets back."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/16_nets_of_comacchio/mission.tres
msgid ""
"The eels of Comacchio are born far away, in the Sargasso Sea across the ocean, and swim all the "
"way to the lagoon. Nobody knew it in 1600: it was found out only around 1920."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "The nets are home!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "You crossed the sea and found the Count's boat."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/16_nets_of_comacchio/mission.tres
msgid "The eel fishers of Comacchio can fish again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Captain, the Count sells \"wind charms\" to the fishermen of this coast."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "He says that without his charm, no boat gets a good wind!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Bring me three charms, from Rimini, Fano and Ancona. Let us see what is inside."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Here, take my charm. Three ducats, and still no wind!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "It is only a little bottle with a cork."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "My husband paid two ducats for this charm."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Shake it: nothing inside! Take it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "The Count's men sold it to me on the pier."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Take it, captain. It never helped me."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/17_wind_seller/mission.tres
msgid "Collect {count} more wind {count|charm|charms}."
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Ha! So you collected my wind charms?"
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "My yellow boat has the best charm of all. Nobody beats it!"
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Race me around the three buoys, in front of the fishermen of Fano!"
msgstr ""

#. what a rival says before a rematch of a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Back for more? The wind still loves me!"
msgstr ""

#. what a rival says before a rematch of a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Again, around the three buoys!"
msgstr ""

#. what the crew hears after winning a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "What? You beat my charm boat?"
msgstr ""

#. what the crew hears after winning a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Bah! The wind was... wrong today."
msgstr ""

#. what the crew hears after winning a race, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "The fishermen of Fano cheer: skill wins, not charms!"
msgstr ""

#. what the crew hears when a rival won the race, one short sentence
#: data/missions/17_wind_seller/mission.tres
msgid "Ha! The wind loves me! The fishermen ask for a rematch tomorrow."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "Skill wins, not charms! Nobody in Fano buys a wind charm any more."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid "We opened them all: empty bottles, every one!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/17_wind_seller/mission.tres
msgid "The Wind Seller"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/17_wind_seller/mission.tres
msgid ""
"Collect three wind charms, then race the Count's charm-boat in front of the fishermen of Fano: "
"skill against charms."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/17_wind_seller/mission.tres
msgid ""
"On the old sea charts of the Mediterranean, the compass rose names eight winds: Tramontana, Greco,"
" Levante, Scirocco, Ostro, Libeccio, Ponente and Maestro. That is how the sailors told the "
"directions."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/17_wind_seller/mission.tres
msgid "Skill beats charms!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/17_wind_seller/mission.tres
msgid "You won the race without a single charm."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/17_wind_seller/mission.tres
msgid "The fishermen of Fano keep their ducats now."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Captain, pilgrims from Pescara want to visit the Holy House of Loreto."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "But the Count's men ask a \"pilgrim toll\" from everybody on the road."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The Pope never allowed such a toll! Take the pilgrims to Loreto by sea."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Pick up the pilgrims in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Captain! We are ready for the voyage to Loreto."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "But look, here comes the Count's toll man..."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "What has a mouth but never eats, and a bed but never sleeps?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "A river"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "A pilgrim"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "A boat"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "What fills a whole sail, but nobody can see it?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "A fish"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The wind"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The Count"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The more of them you take, the more you leave behind. What are they?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Ducats"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Pilgrims"
msgstr ""

#. an answer on a button, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Footsteps"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Halt! Every pilgrim pays the Count's toll!"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Hmm... unless you answer my riddles. The Count loves riddles."
msgstr ""

#. a line after a wrong pick
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Ha! Wrong! Think again, captain."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Grr! You know too much."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Go then, all of you... toll-free!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Bring the pilgrims to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Welcome to Loreto, pilgrims!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "And not a single coin for the Count's toll."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The pilgrims pray in the Holy House, and they sing all the way home."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "And the Count's toll man? He went home to think about riddles."
msgstr ""

#. the title of a mission, on its card
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The Pilgrims of Loreto"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Carry the pilgrims of Pescara past the Count's \"pilgrim toll\" to the Holy House of Loreto."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid ""
"A legend says that angels carried the Holy House of Mary from Nazareth to Loreto. Because of that "
"flying house, the Madonna of Loreto became the patron saint of pilots in 1920."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "The pilgrims reached Loreto!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "You carried the pilgrims past the Count's toll."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/18_pilgrims_of_loreto/mission.tres
msgid "Not one of them paid a coin."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Captain, the Count's toll man left behind a page of the Count's charter."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The Count says it is twenty years old. A paper merchant could tell!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Ser Anselmo of Fabriano sails along the coast. Find him!"
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The paper merchant has {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Have you seen Ser Anselmo, the paper merchant?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "He is here, at the market! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Which one is Ser Anselmo? Remember what the people told you!"
msgstr ""

#. a line after a wrong pick
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "No, that is not Ser Anselmo! Think of everything you heard."
msgstr ""

#. a line after the right pick
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "\"A paper with a secret? Take me to it, captain!\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Bring Ser Anselmo to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "Ser Anselmo holds the page against the light."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "\"See the watermark? This paper was made in Fabriano only this year!\""
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "So it can not be twenty years old. That is our first proof!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "A watermark never lies, captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The Count can forge words, but not the paper of Fabriano!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The Paper with a Secret"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid ""
"Find the paper merchant who can read the charter against the light. Proof 1: the watermark of "
"Fabriano."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/19_paper_with_a_secret/mission.tres
msgid ""
"The paper mills of Fabriano were among the first in Europe. Their papermakers invented the "
"watermark: a picture inside the paper, which shows only against the light."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The first proof!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "You found Ser Anselmo, and the watermark speaks."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/19_paper_with_a_secret/mission.tres
msgid "The Count's paper is new, not twenty years old."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Captain, the Count's seal looks like the seal of the Viceroy."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "A seal-maker of Ortona carved seals for him, then quit and hid."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Find him! He can tell the judges the truth."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "The seal-maker has {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Have you seen the seal-maker who hides from the Count?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "He is hiding here, among the craftsmen! But which one is he?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Which one is the seal-maker? Remember what the people told you!"
msgstr ""

#. a line after a wrong pick
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "No, that is not the seal-maker! Think of everything you heard."
msgstr ""

#. a line after the right pick
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid ""
"\"Yes, I carved the Count's seal. He said it was for a play!\" Mastro Nunzio gives you the mould."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Bring the mould of the seal to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Look: the name of the King is spelt wrong on it!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "No seal of the Viceroy has such a mistake. That is our second proof!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "I will tell the judges everything, captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "From now on, I carve only honest seals!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "The Seal-Maker of Ortona"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "Find the seal-maker who quit the Count and hid. Proof 2: the false seal."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid ""
"Ortona keeps the bones of St. Thomas the Apostle. Sailors of Ortona brought them from the Greek "
"island of Chios in 1258."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "The second proof!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "You found Mastro Nunzio, and the false seal is in Trani."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/20_seal_maker_of_ortona/mission.tres
msgid "The Count spelt the name of the King wrong!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "Captain, an old fisherman here remembers the Count from long ago."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "He says the Count was no count at all, but a young copyist: Bepi Sgorbio!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "Bepi lived on the Gargano. Ask about him there."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/21_white_rock/mission.tres
msgid "Bepi had a friend in {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/21_white_rock/mission.tres
msgid "Ask in {fact}. They knew Bepi there."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/21_white_rock/mission.tres
msgid "Bepi copied letters for the people of {fact}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/21_white_rock/mission.tres
msgid "Did you know Bepi Sgorbio, the copyist?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/21_white_rock/mission.tres
msgid "Bepi? He hid a box of his old letters in the cave under the white rock of Vieste!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "The cave under the white rock? I know the way, even in a storm!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "Here is the box. The letters are signed: Bepi Sgorbio, copyist."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/21_white_rock/mission.tres
msgid "Fetch Bepi's old letters from the white rock."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/21_white_rock/mission.tres
msgid "Bring Bepi's letters to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "Let me compare them with the Count's charter..."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "The same hand wrote them both! That is our third proof!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "Three proofs, captain: the paper, the seal and the letters!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/21_white_rock/mission.tres
msgid "The \"Count\" is nobody but Bepi Sgorbio."
msgstr ""

#. the title of a mission, on its card
#: data/missions/21_white_rock/mission.tres
msgid "The White Rock"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/21_white_rock/mission.tres
msgid ""
"Storms around the Gargano. Under the white rock of Pizzomunno lie Bepi's old letters. Proof 3."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/21_white_rock/mission.tres
msgid ""
"The tall white rock on the beach of Vieste is called Pizzomunno. A legend says it is a young "
"fisherman who turned to stone while he waited for his love Cristalda, whom the mermaids took away."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/21_white_rock/mission.tres
msgid "The third proof!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/21_white_rock/mission.tres
msgid "You braved the storms of the Gargano."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/21_white_rock/mission.tres
msgid "Bepi's old letters show who the Count really is."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Captain, the Count is furious about the three proofs."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "He dares you to a regatta at Barletta: thirteen boats, like the thirteen knights of 1503!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "If you win, the whole coast will see that his charms are nothing."
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Welcome to the Challenge of Barletta, captain!"
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Thirteen boats, three buoys, and glory for the winner!"
msgstr ""

#. what a rival says when he dares the crew to a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "My yellow boat will leave you all behind!"
msgstr ""

#. what a rival says before a rematch of a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Ha! Back for another lesson?"
msgstr ""

#. what a rival says before a rematch of a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Again: thirteen boats, three buoys!"
msgstr ""

#. what the crew hears after winning a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "Impossible! I took the short way, and you still won?"
msgstr ""

#. what the crew hears after winning a race, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The crowd of Barletta cheers for the fair captain!"
msgstr ""

#. what the crew hears when a rival won the race, one short sentence
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The Count was back first, but he cheated! The fishermen ask for a rematch tomorrow."
msgstr ""

#. what the crew hears when a rival cheats in a race, one short sentence
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The Count cuts through the shallows and skips a buoy! That's cheating!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The whole town saw it: the Count cheated, and you won fairly!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "I hammered you a horseshoe, for luck."
msgstr ""

#. the title of a mission, on its card
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The Challenge of Barletta"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid ""
"The Count dares the crew to a regatta of thirteen boats, as the thirteen knights of 1503. He "
"cheats through the shallows; the crew wins fairly."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/22_challenge_of_barletta/mission.tres
msgid ""
"The Challenge of Barletta in 1503 began with an insult at a dinner: a French knight said that the "
"Italians were poor knights. Thirteen knights of each side met in a tournament, and the Italians "
"won."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "A fair win!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "The Count cut through the shallows, and still you won."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/22_challenge_of_barletta/mission.tres
msgid "All of Barletta saw who sails fairly."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Captain! It's me, Luka, the ship's boy. Remember?"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "The Count bought up all the olive oil, and he sells it at three times the price."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "But Vito of Monopoli hid some olives. Help him press them!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Take this salt along: on this coast, salt buys almost anything."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "My olives are picked, but the Count's men took my pressing mats."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Without mats, the press gives no oil. Donata of Brindisi weaves them!"
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Fine mats! The press is turning..."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Here is the oil, captain. Take it to the market of Bari."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "I weave pressing mats from rushes."
msgstr ""

#. what a person in a chain of trades wants, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "But I need salt for my fish. Do you have salt?"
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Salt! Now my fish keeps all winter."
msgstr ""

#. what a person says after a trade, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Here are my best pressing mats."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Bring the oil to the market of {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Oil from Monopoli, at a fair price!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Now everybody in Bari can cook again."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "The Count's oil sits in his cellar, and nobody buys it!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Captain, I will keep my eyes open for him."
msgstr ""

#. the title of a mission, on its card
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Oil for Monopoli"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid ""
"The Count hoards the olive oil. Trade salt for pressing mats, the mats for oil, and bring it to "
"the market of Bari."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/23_oil_for_monopoli/mission.tres
msgid ""
"In Apulia, many olive mills were dug into the rock under the ground. It was warm down there in "
"winter, so the oil flowed better."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Fair oil for Bari!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "Salt, mats and a lot of sailing beat the Count's prices."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/23_oil_for_monopoli/mission.tres
msgid "The kitchens of Bari smell of fresh oil."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
msgid "Captain, the Count has fled with his Golden Charter!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
msgid "Without the charter, the judges can not see his forgery."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
msgid "Chase him! A man so fine can not hide for long."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/24_count_flees/mission.tres
msgid "The Count had {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/24_count_flees/mission.tres
msgid "Have you seen Count Malvento?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/24_count_flees/mission.tres
msgid "Which one is the Count?"
msgstr ""

#. a line after a wrong pick
#: data/missions/24_count_flees/mission.tres
msgid "No, that is not the Count! Remember all four things you learned."
msgstr ""

#. a line after the right pick
#: data/missions/24_count_flees/mission.tres
msgid "\"Alright, alright! Here is the charter. It was such a beautiful charter...\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
msgid "\"Fine, I will come before the judges in Trani.\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/24_count_flees/mission.tres
msgid "With the Golden Charter, the crew holds everything the judges need."
msgstr ""

#. the title of a mission, on its card
#: data/missions/24_count_flees/mission.tres
msgid "The Count Flees"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/24_count_flees/mission.tres
msgid ""
"The Count flees with his charter. Yellow gloves, a smell of violets, a wig too big, a ring with a "
"false seal."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/24_count_flees/mission.tres
msgid ""
"Around 1600, perfumed gloves were the height of fashion. Gloves were scented with violets, roses "
"or amber, also to hide the smell of the leather."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/24_count_flees/mission.tres
msgid "The charter is yours!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/24_count_flees/mission.tres
msgid "You chased the Count along the whole coast and found him."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/24_count_flees/mission.tres
msgid "Now the crew holds the Golden Charter."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Captain, the judges of the Royal Audience in Trani are ready."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Bring them the proofs and the witnesses:"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Luka here in Bari, Michele in Manfredonia and Vito in Monopoli."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "I am ready, captain! I saw the Count take the tolls in Bari."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "I knew Bepi when he was a young copyist."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "I will tell the judges, captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "I will tell the judges how the Count hoarded the oil."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Bring the proofs and the witnesses to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "So this is the Golden Charter. Show me your proofs, captain."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The watermark of Fabriano: this paper is new, not twenty years old."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "A seal with the name of the King spelt wrong!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "And the same hand wrote these letters and the charter."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "What did the paper show against the light?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The watermark of Fabriano"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "A map of the coast"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "A picture of the Count"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Who carved the Count's false seal?"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/25_royal_audience_of_trani/mission.tres data/world/people/brother_romualdo.tres
msgid "Brother Romualdo"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/25_royal_audience_of_trani/mission.tres data/world/people/nunzio.tres
msgid "Mastro Nunzio"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/25_royal_audience_of_trani/mission.tres data/world/items/passenger_luka.tres
#: data/world/people/luka.tres
msgid "Luka"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Where were Bepi's old letters hidden?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "In the Arena of Pula"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "In the palace of the Doge"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Under the white rock of Vieste"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "So who is \"Count Malvento\" really?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "A real count"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Bepi Sgorbio, a copyist"
msgstr ""

#. an answer on a button, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The King of Naples"
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The Royal Audience has seen the proofs. Now, answer my questions."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The court has heard enough. \"Count Malvento\" is Bepi Sgorbio, a copyist."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "He forged his title and his charter. He pays back every toll, and he is a count no more."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "And for one year, he will copy the papers of this court. Honestly!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The fishermen land their catch for free again, from Comacchio to Otranto!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "Baba Stana sent a pigeon: \"Well done, captain!\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "For your courage, you get the medal of the Bird Dog!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The Royal Audience of Trani"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid ""
"Bring the witnesses to the judges in Trani, answer their questions, and the \"Count\" is unmasked "
"as Bepi."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid ""
"From 1586 on, the Royal Audience, a high court of the Kingdom of Naples, sat in Trani. Its judges "
"heard the cases of the whole land of Bari."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The Count is unmasked!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "\"Count Malvento\" was only Bepi Sgorbio, and he pays back every toll."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/25_royal_audience_of_trani/mission.tres
msgid "The whole coast of Italy cheers for the crew!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "Captain, a letter from Senj! Come quickly."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "\"Uskoks\" robbed the ships of Venice. But my brother's boats never left the harbour!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "Venice wants to close the whole coast. Follow the false uskoks!"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/26_caps_too_new/mission.tres
msgid "Have you seen a boat of uskoks who robbed a ship?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/26_caps_too_new/mission.tres
msgid "Which boat is the false uskoks'?"
msgstr ""

#. a line after the right pick
#: data/missions/26_caps_too_new/mission.tres
msgid "That's the one! Its crew jumps ashore and runs. One of them drops his cap."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/26_caps_too_new/mission.tres
msgid "Show the cap to Juraj in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "Ha! Look at this cap! Not a patch, not a hole."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "No uskok wears a cap so new. Somebody dressed up as us!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "The real uskoks of Senj laugh at the cap."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "But who sends the false ones? Venice must hear about it!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/26_caps_too_new/mission.tres
msgid "Caps Too New"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/26_caps_too_new/mission.tres
msgid "False uskoks rob the ships of Venice. Follow their boat, and look at their caps!"
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/26_caps_too_new/mission.tres
msgid ""
"The uskoks sailed light boats with many oars. They slipped into shallow bays where the big galleys"
" of Venice could not follow."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/26_caps_too_new/mission.tres
msgid "False uskoks!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/26_caps_too_new/mission.tres
msgid "You found the false uskok boat."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/26_caps_too_new/mission.tres
msgid "Its brand-new cap shows: these robbers are no uskoks of Senj."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Where do the uskoks live?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "In Corfu"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "In Senj"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "In Venice"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "What gave the false uskoks away?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Their old patched sails"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Their golden flags"
msgstr ""

#. an answer on a button, a few words
#: data/missions/27_the_doges_ten_days/mission.tres data/missions/35_peace_of_rijeka/mission.tres
msgid "Their brand-new caps"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Who sent you a pigeon from Senj?"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/27_the_doges_ten_days/mission.tres data/world/people/ika.tres
msgid "Ika"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/27_the_doges_ten_days/mission.tres data/world/people/alvise.tres
msgid "Messer Alvise"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Captain, Venice will not believe an uskok."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "But it may believe you. Bring the cap to Messer Alvise in Venice!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Bring the cap to the Doge's council in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "A cap of an uskok? It looks as if nobody ever wore it."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Tell the council what you saw, captain."
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "The council listens. Answer our questions, captain."
msgstr ""

#. a line after a wrong pick
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Hmm, no. Think of your voyage, captain."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Then somebody wants a war between Venice and the Habsburgs."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "The council gives you ten days. Bring us proof, captain!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Bring the news to Ika in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Ten days? Then we have no time to lose!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Venice waits, for now."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Let's find out who pays the false uskoks!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "The Doge's Ten Days"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Bring the cap to the Doge's council in Venice, and win ten days to find the proof."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/27_the_doges_ten_days/mission.tres
msgid ""
"Anybody in Venice could drop a secret letter to the councils into a stone lion's mouth in the "
"walls of the Doge's Palace."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Ten days!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "The Doge's council listened to you."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/27_the_doges_ten_days/mission.tres
msgid "Venice waits ten days before it closes the coast."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "Captain, the false uskoks robbed a salt boat of Piran!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "Its owner saw them up close. But she was afraid, and went into hiding."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "Find her somewhere on the coast of Istria!"
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/28_salt_of_piran/mission.tres
msgid "She asked the way to {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/28_salt_of_piran/mission.tres
msgid "She sailed on toward {fact}."
msgstr ""

#. a clue; {fact} is a noun phrase like 'the town with the great Roman arena'
#: data/missions/28_salt_of_piran/mission.tres
msgid "I heard her talk about {fact}."
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/28_salt_of_piran/mission.tres
msgid "The salt merchant had {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/28_salt_of_piran/mission.tres
msgid "Have you seen the salt merchant of Piran?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/28_salt_of_piran/mission.tres
msgid "She is here, among the women of the market! But which one is she?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/28_salt_of_piran/mission.tres
msgid "Which one is the salt merchant of Piran?"
msgstr ""

#. a line after a wrong pick
#: data/missions/28_salt_of_piran/mission.tres
msgid "No, that is not her! Remember all three things."
msgstr ""

#. a line after the right pick
#: data/missions/28_salt_of_piran/mission.tres
msgid "\"Yes, it's me. I saw a fine Habsburg boot under an uskok coat!\""
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/28_salt_of_piran/mission.tres
msgid "Bring Benvenuta's statement to {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "A fine boot of a lord, under an uskok coat?"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "I'll keep it safe, captain. It is our first proof."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "Real uskoks wear sandals of leather straps."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "That boot belonged to a rich man from the Habsburg side!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/28_salt_of_piran/mission.tres
msgid "The Salt of Piran"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid "Find the salt merchant of Piran, who saw the false uskoks up close."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/28_salt_of_piran/mission.tres
msgid ""
"The salt pans of Sečovlje near Piran have been worked for about 700 years. Salt is still made "
"there by hand, the old way."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/28_salt_of_piran/mission.tres
msgid "A witness!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/28_salt_of_piran/mission.tres
msgid "You found Benvenuta, the salt merchant of Piran."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/28_salt_of_piran/mission.tres
msgid "She saw a fine Habsburg boot under the costume."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "Captain! We found a false uskok boat, left on the rocks near Bakar."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "Only a shipwright can tell where its wood comes from."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "Fetch Master Ivan from Pula!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/29_fresh_oak/mission.tres
msgid "Fetch Master Ivan in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "A boat to look at? I'm coming, captain!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/29_fresh_oak/mission.tres
msgid "Bring Master Ivan to the boat in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "Hmm. Fresh oak, cut this spring! Real uskok boats are old and patched."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "This oak grew in the Baron's forest behind Bakar. Take a plank!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/29_fresh_oak/mission.tres
msgid "Bring the plank to Ika in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "Fresh oak from Baron Isengrim's forest?"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "So the wolf is behind it!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "A shipwright can read wood like a book."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "I'll stay in Bakar and look at the Baron's boats a little more."
msgstr ""

#. the title of a mission, on its card
#: data/missions/29_fresh_oak/mission.tres
msgid "Fresh Oak"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/29_fresh_oak/mission.tres
msgid "A false uskok boat was found near Bakar. Fetch Master Ivan to read its wood."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/29_fresh_oak/mission.tres
msgid ""
"Venice kept its own oak forests for the ships of its Arsenal. Nobody could cut a tree there "
"without permission."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/29_fresh_oak/mission.tres
msgid "The wood tells the truth!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/29_fresh_oak/mission.tres
msgid "Master Ivan read the wood of the false boat."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/29_fresh_oak/mission.tres
msgid "It is fresh oak from the forest of Baron Isengrim."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "In which old letters did the priests of Krk write?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "In Glagolitic"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "In Arabic"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "In Greek"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Which town has four bell towers in a row?"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/30_friars_of_kosljun/mission.tres data/world/ports/rab.tres
msgid "Rab"
msgstr ""

#. an answer on a button, a few words
#. a name (of a port, a person, a power, a boat or a thing)
#: data/missions/30_friars_of_kosljun/mission.tres data/world/ports/pula.tres
msgid "Pula"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "\"I lie where Cres and Lošinj almost touch.\" Where is the hideout?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Under the Arena"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "In the Arsenal"
msgstr ""

#. an answer on a button, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Behind Osor"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Captain, the friars on the islet of Košljun see every boat in their bay."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "They sent word: they saw the false boats! Ask Brother Ambroz on Krk."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Talk to Brother Ambroz on {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Peace be with you, captain. Yes, we saw boats with new white sails."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "They sailed south between the islands. Ask in the towns!"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Have you seen boats with brand-new white sails?"
msgstr ""

#. a line in the last port of a trail
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "They hide close by. Brother Ambroz left you a letter about it."
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Brother Ambroz wrote you a riddle, captain."
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "\"Answer me, and you will know where the false boats hide.\""
msgstr ""

#. a line after a wrong pick
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Hmm, no. Read the riddle again, captain."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The cove behind Osor! But the false boats have left it."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Their things are still there, I bet."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The friars of Košljun watch the sea day and night."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "Go with God, captain, and look in that cove!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The Friars of Košljun"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid ""
"The friars on their islet saw where the false boats hide. Follow their word through the islands."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/30_friars_of_kosljun/mission.tres
msgid ""
"Franciscan friars have lived on the islet of Košljun near Krk since 1447. They still keep old "
"books and maps there."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The hideout is found!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The riddle of Brother Ambroz led you to the cove behind Osor."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/30_friars_of_kosljun/mission.tres
msgid "The false uskoks are gone, but their hideout is not."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Uskok coats from the cove, all brand-new!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Take them, captain."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Flags with the uskok sign, never touched by the wind."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "They washed up below my quarry."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Bales of Venetian cloth, hidden in the cave of my sheep!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "This is the stolen cargo."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Captain, the cove is empty, but the false uskoks left in a hurry."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "The people of the islands found their things. Collect them all!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/31_hidden_cove/mission.tres
msgid "Collect {count} more {count|thing|things} from the hideout."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/31_hidden_cove/mission.tres
msgid "Bring everything to Juraj in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Look at these coats! Not one of us ever wore them."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "And false flags! They were sewn last month."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "The cloth of the Venetian ships! We will give it back."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Costumes, flags and the stolen cloth: a whole chest of proof!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "Now we only need to know who paid for it all."
msgstr ""

#. the title of a mission, on its card
#: data/missions/31_hidden_cove/mission.tres
msgid "The Hidden Cove"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/31_hidden_cove/mission.tres
msgid "The hideout of the false uskoks is empty. Collect what they left behind on the islands."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/31_hidden_cove/mission.tres
msgid ""
"The canal of Osor was dug already in Roman times. Boats still sail through it between Cres and "
"Lošinj, under a bridge which swings aside."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/31_hidden_cove/mission.tres
msgid "The proofs are in Senj!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/31_hidden_cove/mission.tres
msgid "You collected the costumes, the flags and the stolen cloth."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/31_hidden_cove/mission.tres
msgid "Juraj keeps them safe in the Nehaj fortress."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "Captain, the Baron's steward was here, asking about you!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "He carries the payroll: the list of the men paid to play uskoks."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "He fled by boat. Chase him!"
msgstr ""

#. a clue; {hallmark} is a noun phrase like 'a patched red sail'
#: data/missions/32_stewards_ledger/mission.tres
msgid "The steward had {hallmark}."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/32_stewards_ledger/mission.tres
msgid "Have you seen the Baron's steward?"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/32_stewards_ledger/mission.tres
msgid "Which one is the Baron's steward?"
msgstr ""

#. a line after a wrong pick
#: data/missions/32_stewards_ledger/mission.tres
msgid "No, that is not the steward! Remember all four things you learned."
msgstr ""

#. a line after the right pick
#: data/missions/32_stewards_ledger/mission.tres
msgid "\"Alright! Here is the payroll. The Baron signed every page.\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "\"The Baron never even paid me!\""
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "\"I will tell the Archduke's commissioner everything.\""
msgstr ""

#. the title of a mission, on its card
#: data/missions/32_stewards_ledger/mission.tres
msgid "The Steward's Ledger"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid "The Baron's steward flees with the payroll of the false uskoks. Chase him!"
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/32_stewards_ledger/mission.tres
msgid ""
"Around 1600, Rijeka and Trieste belonged to the Archduke of Inner Austria, a Habsburg who ruled "
"from the town of Graz."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/32_stewards_ledger/mission.tres
msgid "The payroll is yours!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/32_stewards_ledger/mission.tres
msgid "You chased the steward through Kvarner and Istria."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/32_stewards_ledger/mission.tres
msgid "His payroll shows who paid the false uskoks: Baron Isengrim."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "Captain, the Archduke sent a commissioner to Trieste."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "He will judge the Baron, but Venice must send an envoy, too."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "Get his safe-conduct for the envoy, and carry it to Venice!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/33_two_flags/mission.tres
msgid "Get the safe-conduct of the commissioner in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "The Baron has shamed the Archduke's name."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "With this letter, the envoy of Venice may come safely to Rijeka."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/33_two_flags/mission.tres
msgid "Bring the safe-conduct to the envoy in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "A safe-conduct of the Archduke, for a Venetian? Times change!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "I will sail to Rijeka at once."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "The lion of St. Mark and the eagle of the Habsburgs at one table."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/33_two_flags/mission.tres
msgid "Peace is worth a voyage, captain!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/33_two_flags/mission.tres
msgid "Two Flags"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/33_two_flags/mission.tres
msgid ""
"Carry the commissioner's safe-conduct from Trieste to the envoy in Venice. Mind both patrols!"
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/33_two_flags/mission.tres
msgid ""
"A safe-conduct was a letter which promised a traveller that nobody would stop or harm him, even in"
" the land of another ruler."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/33_two_flags/mission.tres
msgid "The envoy is coming!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/33_two_flags/mission.tres
msgid "You carried the safe-conduct past the patrols of two powers."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/33_two_flags/mission.tres
msgid "The envoy of Venice sails to Rijeka."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "I'll come, bura or no bura!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "The Lord gave us the bura, and the captain to sail in it."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "Let's go!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "I have counted the Baron's planks. Every one is fresh oak!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "Captain, the meeting in Rijeka is soon!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "Bring the witnesses: Juraj, Brother Ambroz on Krk and Master Ivan in Bakar."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "But hold on tight: the bura is blowing hard today."
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/34_through_the_bura/mission.tres
msgid "Bring the witnesses to the commissioner in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "An uskok captain, here of his own free will. Welcome."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "A friar of Košljun. Your word weighs much, brother."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "And the shipwright who reads wood. Tomorrow, we meet."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "We sailed through the hardest bura of the year!"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "Tomorrow, the truth comes out."
msgstr ""

#. the title of a mission, on its card
#: data/missions/34_through_the_bura/mission.tres
msgid "Through the Bura"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/34_through_the_bura/mission.tres
msgid "The hardest bura of all. Bring Juraj, the friar and Master Ivan to the meeting in Rijeka."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/34_through_the_bura/mission.tres
msgid ""
"The bura falls cold from the Velebit mountains onto the sea. Near Senj, its gusts can blow faster "
"than 200 kilometres an hour."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/34_through_the_bura/mission.tres
msgid "Through the bura!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/34_through_the_bura/mission.tres
msgid "You brought every witness to Rijeka, through the hardest bura."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/34_through_the_bura/mission.tres
msgid "The commissioner and the envoy are ready."
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "What gave the false uskoks away first?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Their old boots"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Their black flag"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "What did the salt merchant of Piran see under the costume?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "A wooden leg"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "A fine Habsburg boot"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "A golden spur"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "What were the false boats built of?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Old patched pine"
msgstr ""

#. an answer on a button, a few words
