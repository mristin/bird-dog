#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Fresh oak of the Baron's forest"
msgstr ""

#. what the crew asks, or what the crew is asked
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Whose name is on the steward's payroll?"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Juraj's"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Baron Isengrim's"
msgstr ""

#. an answer on a button, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "The Doge's"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Captain, today the commissioner and the envoy meet."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "We have the cap, the oak, the costumes, the payroll and the witnesses."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Show them the payroll, and answer well!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Bring the payroll to the commissioner in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "The envoy of Venice and I have read everything."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Now, answer our questions."
msgstr ""

#. what a judge says before the questions, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Messer Marcantonio listens for Venice. I ask for the Archduke."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "The uskoks of Senj did not rob the ships. Venice calls off the blockade."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Baron Isengrim loses his lands and pays back every cargo."
msgstr ""

#. what a judge says after the right answers, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "And he will muck out the stables of the Archduke's horses in Lipica!"
msgstr ""

#. the objective while sailing, on the banner
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Tell Baron Isengrim the ruling in {port}."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Stables? Me? With a shovel?"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "...Fine. But I keep my wolf hat."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Peace, captain! Take me home to Senj."
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Brother! The whole town is on the walls of Nehaj, waving!"
msgstr ""

#. a line of thanks, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "You are home, captain! Two empires made peace thanks to you."
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Everybody came to the Arena: Ika and Juraj, Master Ivan and Katarina,"
msgstr ""

#. a line which a person says, at most two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Benvenuta, Brother Ambroz, Messer Alvise, Luka from Bari, and the children of Grebaštica!"
msgstr ""

#. the title of a mission, on its card
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "The Peace of Rijeka"
msgstr ""

#. the summary of a mission, one or two short sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Answer the commissioner and the envoy in Rijeka, bring Juraj home, and sail home to Pula."
msgstr ""

#. a fun fact at the end of a mission, at most three sentences
#: data/missions/35_peace_of_rijeka/mission.tres
msgid ""
"The real story was less happy: Venice and the Habsburgs fought the Uskok War in 1615–1617, and "
"then the uskoks were moved from Senj inland. The stud of Lipica, founded in 1580, still breeds the"
" white Lipizzaner horses."
msgstr ""

#. the headline of the screen at the end of a mission, a few words
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Peace on the Adriatic!"
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Venice called off the blockade, and the Baron mucks out the stables of Lipica."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "Juraj's crew becomes the pilots and the rescuers of Kvarner."
msgstr ""

#. what the crew achieved, on the screen at the end of a mission, one sentence
#: data/missions/35_peace_of_rijeka/mission.tres
msgid "The whole Arena of Pula cheers!"
msgstr ""

