#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Get on all fours: hands under the shoulders, knees under the hips."
msgstr "Dört ayak üstüne {crew|gel|gel|gelin}: eller omuzların, dizler kalçaların altında."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Keep your back flat, like a table."
msgstr "{crew|Sırtını düz tut|Sırtını düz tut|Sırtınızı düz tutun}, bir masa gibi."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look at the floor, a little ahead of your hands."
msgstr "{crew|Yere bak, ellerinin|Yere bak, ellerinin|Yere bakın, ellerinizin} biraz önüne."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Stretch one arm forward and the opposite leg back."
msgstr ""
"{crew|Bir kolunu öne, karşı bacağını geriye uzat.|Bir kolunu öne, karşı bacağını geriye uzat.|Bir "
"kolunuzu öne, karşı bacağınızı geriye uzatın.}"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Hold still: belly tight, hips level."
msgstr "{crew|Kıpırdama|Kıpırdama|Kıpırdamayın}: karın sıkı, kalçalar düz."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Then slowly back..."
msgstr "Sonra yavaşça geri..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...and the other arm with the other leg."
msgstr "...ve şimdi öbür kol ile öbür bacak."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your back sag..."
msgstr "{crew|Sırtın|Sırtın|Sırtınız} çökmesin..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep it flat."
msgstr "...düz {crew|tut|tut|tutun}."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't throw your head up..."
msgstr "{crew|Başını yukarı kaldırma|Başını yukarı kaldırma|Başınızı yukarı kaldırmayın}..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...look at the floor."
msgstr "...yere {crew|bak|bak|bakın}."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't let your hip roll open..."
msgstr "{crew|Kalçan|Kalçan|Kalçanız} yana açılmasın..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...keep your hips level."
msgstr "...{crew|kalçalarını düz tut|kalçalarını düz tut|kalçalarınızı düz tutun}."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Don't kick your leg up too high..."
msgstr ""
"{crew|Bacağını çok yükseğe kaldırma|Bacağını çok yükseğe kaldırma|Bacağınızı çok yükseğe "
"kaldırmayın}..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...level with your back is enough."
msgstr "...{crew|sırtınla|sırtınla|sırtınızla} aynı hizada olması yeter."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Not fast and jerky..."
msgstr "Hızlı ve kesik kesik değil..."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "...but slow and calm."
msgstr "...yavaş ve sakin."

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "2/2  How you steer the boat"
msgstr "2/2  Tekneyi nasıl {crew|yönlendirirsin|yönlendirirsin|yönlendirirsiniz}"

#: scenes/instruction/instruction.gd
#, fuzzy
msgid "Look: this is you, as the camera sees you."
